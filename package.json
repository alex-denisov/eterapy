{
  "name": "eterapy-monorepo",
  "private": true,
  "workspaces": [
    "web"
  ],
  "scripts": {
    "security:secrets": "node scripts/security-secret-scan.mjs",
    "security:sast": "node scripts/security-sast-scan.mjs",
    "security:audit": "node scripts/security-audit-summary.mjs",
    "security:audit:gate": "node scripts/security-audit-summary.mjs --fail-on=high",
    "security:baseline": "npm run security:secrets && npm run security:sast && npm run security:audit"
  },
  "dependencies": {
    "@prisma/client": "^7.7.0",
    "prisma": "^7.7.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.2",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "babel-jest": "^30.3.0"
  }
}
