# INC-098 — сигнализация об упавшем systemd-юните.
#
# SEO-отчёт падал КАЖДЫЙ день с момента установки таймера и не дошёл до
# владельца ни разу. Отказ при этом честно записывался в journal — но журнал
# ноды никто не читает, а наружу не выходило ничего: механизм «упало и молчит»
# устроен так, что чем важнее задача, тем дольше её отсутствие незаметно.
#
# Шаблонный юнит: любой сервис добавляет себе `OnFailure=eterapy-unit-failure@%n.service`
# и получает сообщение в служебный канал с хвостом журнала.
#
# Сам уведомитель намеренно НЕ имеет OnFailure: если не удалось сообщить о
# падении, писать об этом некуда, а рекурсия юнитов — верный способ залить
# журнал вместо доставки.

[Unit]
Description=ETerapy: сообщить в Telegram об упавшем юните %i

[Service]
Type=oneshot
ExecStart=/opt/eterapy/notify-unit-failure.sh %i
TimeoutStartSec=2min
