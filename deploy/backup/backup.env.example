# B536 — off-host backup config. Copy to /opt/eterapy/backup.env (chmod 600).
# Secrets live here only; never commit a filled-in copy.

# Database to dump (system cluster on eterapy-1; container `db` on the fleet).
PGDATABASE=eterapy
PGUSER=postgres
# 1 = dump via `sudo -u postgres` (system cluster peer auth).
# 0 = use PGUSER/PGPASSWORD directly (container fleet).
USE_SUDO_POSTGRES=1
# PGPASSWORD=            # only when USE_SUDO_POSTGRES=0

# Symmetric passphrase (AES256). MUST be backed up off-box by the owner —
# without it the encrypted dumps are unrecoverable.
BACKUP_PASSPHRASE=

# Space-separated rclone remotes. RU production → cloud.ru ONLY (152-ФЗ):
# two independent accounts = two independent RU copies.
#   BACKUP_REMOTES="cloudru1:eterapy-data/db cloudru2:eterapy-data/db"
BACKUP_REMOTES=

BACKUP_LOCAL_DIR=/opt/eterapy/backups
BACKUP_KEEP=14
BACKUP_LABEL=eterapy-1

# Telegram alert (reuse the fleet bot). Optional but recommended.
TG_TOKEN=
TG_CHAT=
