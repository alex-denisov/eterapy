# ─────────────────────────────────────────────────────────────────────────────
# B473 — THE single variables file. Copy to /opt/eterapy/.env on the VM and
# edit; `docker compose up -d` converges to it. Compose interpolation and the
# app's runtime env both read this file.
#
# NEXT_PUBLIC_* values are baked into the image at CI build time — changing
# the domain requires rebuilding the image (deploy workflow inputs), the rest
# applies on restart.
# ─────────────────────────────────────────────────────────────────────────────

# ── Release ──
ETERAPY_IMAGE=eterapy-web:latest

# ── Reverse proxy / domain ──
# Bare-IP HTTP:      CADDY_SITE_ADDRESS=:80
# Domains + auto-TLS: CADDY_SITE_ADDRESS=eterapy.com, app.eterapy.com, admin.eterapy.com
CADDY_SITE_ADDRESS=:80

# ── Database (compose-managed Postgres) ──
ETERAPY_DB_NAME=eterapy
ETERAPY_DB_USER=eterapy
ETERAPY_DB_PASSWORD=change-me
ETERAPY_BACKUP_KEEP=14
DATABASE_URL=postgresql://eterapy:change-me@db:5432/eterapy?schema=public

# ── Core app ──
NODE_ENV=production
AUTH_SECRET=generate-with--openssl-rand-base64-32
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://107.172.153.202
NEXT_PUBLIC_APP_URL=http://107.172.153.202
NEXT_PUBLIC_USE_SUBDOMAINS=false
NEXT_PUBLIC_MAIN_DOMAIN=107.172.153.202
NEXT_PUBLIC_APP_DOMAIN=107.172.153.202
NEXT_PUBLIC_ADMIN_DOMAIN=107.172.153.202
CRON_SECRET=generate-me
WORKER_CRON_FINANCIAL=false

# ── Feature/провайдерные ключи (пустые = функция деградирует, сайт работает) ──
RESEND_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER_MODE=auto
FOREIGN_LLM_ENABLED=true
FOREIGN_LLM_FALLBACK_ENABLED=true
CLOUDFLARE_AI_GATEWAY_ENABLED_FOR_RU=true
AI_CREDENTIAL_KEY=
CF_AI_GATEWAY_ACCOUNT_ID=
CF_AI_GATEWAY_ID=
CF_AI_GATEWAY_TOKEN=
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_PRIMARY_MODEL=
YANDEX_FALLBACK_MODELS=
# Временный audio-only контур AI-конспекта видеосессий. Можно использовать
# тот же API key сервисного аккаунта, что выше, либо отдельный SpeechKit key.
YANDEX_SPEECHKIT_API_KEY=
YANDEX_S3_ACCESS_KEY_ID=
YANDEX_S3_SECRET_ACCESS_KEY=
YANDEX_S3_BUCKET=
YANDEX_S3_ENDPOINT=https://storage.yandexcloud.net
YANDEX_S3_REGION=ru-central1
CROSS_BORDER_PROCESSING_ENABLED=true
LEGAL_CROSS_BORDER_READY=true
YUKASSA_SHOP_ID=
YUKASSA_SECRET_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=eterapy_bot
TELEGRAM_WEBHOOK_SECRET=
# Автономный SMM/SEO-сервис. Пока коннекторы не заполнены, сервис и админка
# работают в режиме подготовки; наружу ничего не уходит.
MARKETING_AGENT_ENABLED=false
MARKETING_AGENT_ALLOW_STAGING=false
MARKETING_AGENT_POLL_MS=60000
# Narrow public-social route for OpenRouter/Gemini/Cerebras/Groq in the
# marketing worker. Internal ETerapy user data stays outside this prompt path.
MARKETING_FOREIGN_LLM_ENABLED=false
MARKETING_AUTOPUBLISH=false
MARKETING_MODERATION_SECRET=
TELEGRAM_CHANNEL_ID=
VK_COMMUNITY_TOKEN=
VK_COMMUNITY_ID=
REDDIT_ACCESS_TOKEN=
REDDIT_USER_AGENT=ETerapySMM/1.0
REDDIT_SUBREDDITS=
REDDIT_POST_SUBREDDIT=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
# B566: теперь default-ON — значение живёт в образе, а не в host state, чтобы
# включение приезжало выкаткой, а не правкой этого файла на ноде. Оставляйте
# ключ ПУСТЫМ/убранным. Явное `=false` — аварийный рубильник: гасит вход через
# Telegram, обычный вход по почте не трогает. Контур без TELEGRAM_BOT_TOKEN
# ничего не открывает и без рубильника (подпись проверить нечем → 503).
# TELEGRAM_MINIAPP_SSO_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VK_CLIENT_ID=
VK_CLIENT_SECRET=
VK_SERVICE_TOKEN=
OFDATA_API_KEY=
TAX_VERIFICATION_PROVIDER=ofdata
AGENT_OAUTH_PRIVATE_KEY_JWK=
AGENT_OAUTH_CLIENT_HMAC_SECRET=
MANAGEMENT_SPECIAL_ORDER_ID=
