# B572 — SEO-отчёт в Telegram ежедневно в 09:00 МСК.
#
# Раньше расписание жило в GitHub Actions и не работало: cron там
# best-effort — по этому же репозиторию почасовой воркфлоу за сутки
# отработал 12 раз из 25, с опозданиями до 1ч55м. Владелец ждал отчёт
# в 9 утра и не получил его вовсе.
#
# Часовой пояс ноды — Europe/Moscow, поэтому OnCalendar задан в местном
# времени без пересчёта.

[Unit]
Description=ETerapy: ежедневный SEO-отчёт в Telegram

[Timer]
OnCalendar=*-*-* 09:00:00
# Нода могла быть выключена в 09:00 (учение B537) — отчёт уйдёт при старте.
Persistent=true
AccuracySec=1min
Unit=eterapy-seo-report.service

[Install]
WantedBy=timers.target
