# B572 — разовый прогон SEO-отчёта, запускается таймером eterapy-seo-report.timer.
#
# Креды скрипт достаёт сам из /opt/eterapy/.env (их туда кладёт выкатка из
# секретов репозитория). EnvironmentFile здесь намеренно не используется:
# systemd разбирает такой файл по своим правилам и спотыкается о пароли со
# спецсимволами, а весь .env ноды этому юниту и не нужен.

[Unit]
Description=ETerapy: собрать и отправить SEO-отчёт
After=network-online.target
Wants=network-online.target
# INC-098: отказ обязан выходить наружу. Этот отчёт падал каждый день с момента
# установки таймера и не дошёл до владельца ни разу — журнал ноды об этом
# исправно писал, но журнал никто не читает.
OnFailure=eterapy-unit-failure@%n.service

[Service]
Type=oneshot
ExecStart=/opt/eterapy/seo-telegram-report.sh
# Restart= с Type=oneshot systemd не принимает (юнит просто не загрузится).
# Внешние API иногда отвечают не с первого раза — повтор делает сам скрипт
# на уровне curl, а неудачный день виден в `systemctl status`.
TimeoutStartSec=10min
