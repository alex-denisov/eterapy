model UserSubscription {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey                String
  status                 String    @default("TRIALING") // TRIALING | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  provider               String    @default("yookassa")
  providerSubscriptionId String?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  cancelledAt            DateTime?
  // B348 / Механика 1: timestamp of the last 3-day auto-renewal reminder sent
  // for the CURRENT period. Compared against currentPeriodStart so each period
  // is reminded at most once. NULL = not yet reminded this period.
  renewalReminderAt      DateTime?
  metadata               Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId, status])
  @@index([planKey, status])
  @@index([providerSubscriptionId])
  @@index([status, currentPeriodEnd])
  @@map("user_subscriptions")
}

model CreditLedgerEntry {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountKopecks       Int
  balanceAfterKopecks Int?
  currency            String   @default("RUB")
  type                String // TOPUP | PRODUCT_PURCHASE | SUBSCRIPTION_CHARGE | REFUND | ADJUSTMENT
  source              String   @default("yookassa")
  transactionId       String?
  description         String?
  metadata            Json?
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
  @@index([transactionId])
  @@map("credit_ledger_entries")
}

model ClarityCreditLedgerEntry {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int
  balanceAfter  Int?
  type          String // grant | spend | expire | clawback | adjustment
  source        String // referral | mission | purchase | subscription | admin | product
  sourceEventId String?
  status        String    @default("confirmed") // pending | confirmed | revoked | expired
  expiresAt     DateTime?
  metadata      Json?
  createdAt     DateTime  @default(now())

  @@index([userId, status, createdAt])
  @@index([source, sourceEventId])
  @@index([expiresAt])
  @@map("clarity_credit_ledger_entries")
}

model MissionProgress {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  missionKey      String
  status          String    @default("ACTIVE") // ACTIVE | COMPLETED
  progress        Int       @default(0)
  target          Int       @default(1)
  completedAt     DateTime?
  rewardGrantedAt DateTime?
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, missionKey])
  @@index([userId, status])
  @@index([completedAt])
  @@map("mission_progress")
}

// ─── Compatibility ────────────────────────────────────────────────────────────

model Compatibility {
  id                      String         @id @default(cuid())
  creatorId               String         @map("creator_id")
  creator                 User           @relation("CompatibilityCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  partnerId               String?        @map("partner_id")
  partner                 User?          @relation("CompatibilityPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  type                    String // romantic | friendship | business | family
  status                  String         @default("CREATED") // CREATED | INVITED | PARTNER_COMPLETED | READY | DELETED
  inviteToken             String         @unique @default(cuid()) @map("invite_token")
  inviteExpiresAt         DateTime?      @map("invite_expires_at")
  creatorDialogueId       String?        @map("creator_dialogue_id")
  partnerDialogueId       String?        @map("partner_dialogue_id")
  creatorConsent          Boolean        @default(false) @map("creator_consent")
  partnerConsent          Boolean        @default(false) @map("partner_consent")
  teaserText              String?        @map("teaser_text")
  riskScore               Int            @default(0) @map("risk_score")
  riskFlags               String[]       @default([]) @map("risk_flags")
  creatorIpHash           String?        @map("creator_ip_hash")
  creatorUserAgentHash    String?        @map("creator_user_agent_hash")
  creatorDeviceHash       String?        @map("creator_device_hash")
  partnerIpHash           String?        @map("partner_ip_hash")
  partnerUserAgentHash    String?        @map("partner_user_agent_hash")
  partnerDeviceHash       String?        @map("partner_device_hash")
  partnerSubmittedAfterMs Int?           @map("partner_submitted_after_ms")
  reportedAt              DateTime?      @map("reported_at")
  reportedReason          String?        @map("reported_reason")
  declinedAt              DateTime?      @map("declined_at")
  metadata                Json?
  reportId                String?        @unique @map("report_id")
  report                  ProductResult? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt               DateTime       @default(now()) @map("created_at")
  updatedAt               DateTime       @updatedAt @map("updated_at")

  @@index([creatorId])
  @@index([partnerId])
  @@index([inviteToken])
  @@index([inviteExpiresAt])
  @@index([creatorDeviceHash, createdAt])
  @@index([partnerDeviceHash, createdAt])
  @@map("compatibilities")
}

model ClarityCircle {
  id                   String                     @id @default(cuid())
  creatorId            String                     @map("creator_id")
  creator              User                       @relation("ClarityCircleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  question             String
  topic                String?
  status               String                     @default("INVITING") // INVITING | READY | DELETED
  inviteToken          String                     @unique @default(cuid()) @map("invite_token")
  inviteExpiresAt      DateTime                   @map("invite_expires_at")
  teaserText           String?                    @map("teaser_text")
  reportId             String?                    @unique @map("report_id")
  report               ProductResult?             @relation(fields: [reportId], references: [id], onDelete: SetNull)
  creatorIpHash        String?                    @map("creator_ip_hash")
  creatorUserAgentHash String?                    @map("creator_user_agent_hash")
  creatorDeviceHash    String?                    @map("creator_device_hash")
  metadata             Json?
  participants         ClarityCircleParticipant[]
  createdAt            DateTime                   @default(now()) @map("created_at")
  updatedAt            DateTime                   @updatedAt @map("updated_at")

  @@index([creatorId, status, createdAt])
  @@index([inviteToken])
  @@index([inviteExpiresAt])
  @@index([creatorDeviceHash, createdAt])
  @@map("clarity_circles")
}

model ClarityCircleParticipant {
  id               String        @id @default(cuid())
  circleId         String        @map("circle_id")
  circle           ClarityCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId           String?       @map("user_id")
  user             User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName      String?       @map("display_name")
  answerText       String        @map("answer_text")
  consent          Boolean       @default(false)
  status           String        @default("SUBMITTED") // SUBMITTED | HIDDEN | DELETED
  riskScore        Int           @default(0) @map("risk_score")
  riskFlags        String[]      @default([]) @map("risk_flags")
  ipHash           String?       @map("ip_hash")
  userAgentHash    String?       @map("user_agent_hash")
  deviceHash       String?       @map("device_hash")
  answerHash       String?       @map("answer_hash")
  submittedAfterMs Int?          @map("submitted_after_ms")
  reportedAt       DateTime?     @map("reported_at")
  reportedReason   String?       @map("reported_reason")
  metadata         Json?
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@unique([circleId, userId])
  @@index([circleId, status, createdAt])
  @@index([userId])
  @@index([circleId, deviceHash])
  @@index([answerHash, createdAt])
  @@map("clarity_circle_participants")
}

// ─── 7 Days to Clarity ────────────────────────────────────────────────────────

model ClarityRoute {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  dialogueId  String?        @map("dialogue_id")
  dialogue    Dialogue?      @relation(fields: [dialogueId], references: [id], onDelete: SetNull)
  title       String
  status      String         @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | CANCELLED
  currentDay  Int            @default(1) @map("current_day")
  reportId    String?        @unique @map("report_id")
  report      ProductResult? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  completedAt DateTime?      @map("completed_at")

  @@index([userId])
  @@index([status])
  @@map("clarity_routes")
}

// ─── Analytics Events ─────────────────────────────────────────────────────────

model AnalyticsEvent {
  id         String   @id @default(cuid())
  event      String // e.g. "home_viewed", "specialist_recommended"
  userId     String?  @map("user_id")
  sessionId  String?  @map("session_id") // guest session or anon fingerprint
  dialogueId String?  @map("dialogue_id")
  surface    String? // "public_home", "checkin", "cabinet", etc.
  properties Json? // arbitrary event properties
  ipHash     String?  @map("ip_hash")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([event, createdAt])
  @@index([userId, createdAt])
  @@index([dialogueId])
  @@map("analytics_events")
}

// ─── B482 · First-party Support Chat ───────────────────────────────────────
//
// MVP polling-based chat. A SupportConversation is opened on the first
// user message; it stays open until support staff or a sweeper closes it.
// Staff replies are written by an authorized operator in /admin/support
// and surface in the cabinet UI on the next poll (~3s). Telegram receives only
// a content-free availability alert; legacy telegram* columns remain nullable
// until a later cleanup migration can remove them safely.

model SupportConversation {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Legacy Telegram routing metadata (no longer written after B482).
  telegramChatId   String?   @map("telegram_chat_id")
  telegramThreadId Int?      @map("telegram_thread_id")
  status           String    @default("OPEN") // OPEN | CLOSED
  subject          String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  closedAt         DateTime? @map("closed_at")

  messages SupportMessage[]

  @@index([userId, status])
  @@index([telegramChatId, telegramThreadId])
  @@map("support_conversations")
}

model SupportMessage {
  id                String              @id @default(cuid())
  conversationId    String              @map("conversation_id")
  conversation      SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role              String // USER | STAFF | SYSTEM
  content           String
  // Legacy upstream Telegram id (no longer written after B482).
  telegramMessageId Int?                @map("telegram_message_id")
  createdAt         DateTime            @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@index([telegramMessageId])
  @@map("support_messages")
}

// B591: ручные приходы и расходы вне платёжного рельса. Платёжная книга видит
// только Robokassa и Telegram Stars; счёт, банковские комиссии, хостинг и
// взносы платформа не видит вовсе, а бухгалтеру они нужны.
// `taxable` — только про приход: на УСН «Доходы» расход базу не уменьшает.
model IpLedgerEntry {
  id            String   @id @default(cuid())
  occurredAt    DateTime @map("occurred_at") @db.Date
  direction     String
  categoryKey   String   @map("category_key")
  amountKopecks Int      @map("amount_kopecks")
  taxable       Boolean  @default(true)
  counterparty  String?
  documentRef   String?  @map("document_ref")
  note          String?
  createdById   String?  @map("created_by_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  importKey     String?  @unique @map("import_key")
  importSource  String?  @map("import_source")

  @@index([occurredAt])
  @@index([direction, occurredAt])
  @@map("ip_ledger_entries")
}
