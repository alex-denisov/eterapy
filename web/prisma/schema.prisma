// ─── Transactions ─────────────────────────────────────────────────────────────

model Transaction {
  id                   String            @id @default(cuid())
  userId               String
  amount               Int // positive = top-up, negative = charge
  currency             String            @default("RUB")
  status               TransactionStatus @default(PENDING)
  provider             String            @default("yookassa") // "robokassa", "yookassa", "internal", "manual"
  providerPaymentId    String? // provider-side payment id (Robokassa: the InvId as text)
  /// Robokassa `InvId`: a positive integer unique per shop. Allocated when the
  /// transaction row is created, BEFORE the payment link is signed, so a retry
  /// of the same checkout reuses it and Robokassa collapses the duplicate.
  invoiceId            Int               @unique @default(autoincrement()) @map("invoice_id")
  description          String?
  /// B571: каким комплектом ключей Robokassa подписан ЭТОТ платёж.
  /// ResultURL приходит подписанным паролем #2 того же комплекта, поэтому
  /// режим обязан жить на транзакции: признак у пользователя могут снять между
  /// оплатой и колбэком, и тогда проверка подписи пошла бы не той парой.
  testMode             Boolean           @default(false) @map("test_mode")
  paymentDeclineReason String?           @map("payment_decline_reason")
  offerVersion         String?           @map("offer_version")
  termsVersion         String?           @map("terms_version")
  consentVersion       String?           @map("consent_version")
  metadata             Json?
  fiscalReceiptStatus  String?           @map("fiscal_receipt_status")
  fiscalReceiptRef     String?           @map("fiscal_receipt_ref")
  fiscalReceiptCheckedAt DateTime?       @map("fiscal_receipt_checked_at")
  fiscalReceiptError   String?           @map("fiscal_receipt_error")
  createdAt            DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerPaymentId])
  @@index([userId, createdAt])
  @@map("transactions")
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  CANCELLED
  REFUNDED
}

