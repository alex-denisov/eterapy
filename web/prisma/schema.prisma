generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  // B372 (M26): нормализованный e-mail для антифрода gmail-дублей
  // (точки и +suffix в local part у gmail/googlemail схлопываются).
  normalizedEmail       String?   @map("normalized_email")
  name                  String
  password              String
  role                  Role      @default(CLIENT)
  emailVerified         Boolean   @default(false)
  avatarUrl             String?
  deletedAt             DateTime? // deactivated at this time, purge after 10 days
  blockedAt             DateTime? // blocked by admin — cannot login
  freeToolsLimit        Int? // null = plan default (3), 0 = unlimited
  verificationToken     String?   @unique
  verificationExpires   DateTime?
  resetToken            String?   @unique
  resetExpires          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  practiceStreakCount   Int       @default(0) @map("practice_streak_count")
  practiceStreakLongest Int       @default(0) @map("practice_streak_longest")
  practiceLastDoneDate  DateTime? @map("practice_last_done_date")

  // Identity
  provider            String? @default("web") // "vk", "google", "web", "mobile_web", "ios", "android", "manual", "telegram", "max"
  providerId          String? // ID from provider (e.g., VK user_id, Google sub)
  registrationChannel String? // "site", "google", "vk", "telegram", "referral" — откуда пришёл

  // Telegram
  telegramId       String? @unique // Telegram chat_id (set via bot)
  telegramUsername String? // @username

  // Extended profile (for AI personalization)
  birthDate       DateTime?
  birthDateSource String?   @map("birth_date_source")
  birthTime       String? // "14:30" — for natal chart
  birthPlace      String? // city name
  timezone        String? // e.g. "Europe/Moscow"
  maritalStatus   String? // single/married/divorced/etc
  occupation      String?
  aiGoals         String[]  @default([]) // career/relationships/selfdev/health/etc

  // Relations
  practitioner                    Practitioner?
  bookingsAsClient                Booking[]                  @relation("BookingClient")
  toolSessions                    ToolSession[]
  reviewsWritten                  Review[]                   @relation("ReviewAuthor")
  storedFiles                     StoredFile[]
  chatMessages                    ChatMessage[]
  notificationPrefs               NotificationPreference[]
  notifications                   Notification[]
  complaints                      Complaint[]                @relation("ComplaintReporter")
  aiSessionLogs                   AISessionLog[]
  aiGatewayRequests               AIRequest[]
  dialogues                       Dialogue[]
  productResults                  ProductResult[]
  transactions                    Transaction[]
  savedCards                      SavedCard[]
  entitlements                    ProductEntitlement[]
  subscriptions                   UserSubscription[]
  creditLedgerEntries             CreditLedgerEntry[]
  clarityCreditLedgerEntries      ClarityCreditLedgerEntry[]
  compatibilitiesCreated          Compatibility[]            @relation("CompatibilityCreator")
  compatibilitiesJoined           Compatibility[]            @relation("CompatibilityPartner")
  clarityCirclesCreated           ClarityCircle[]            @relation("ClarityCircleCreator")
  clarityCircleParticipations     ClarityCircleParticipant[]
  clarityRoutes                   ClarityRoute[]
  dailyCards                      DailyCard[]
  missionProgresses               MissionProgress[]
  shareLinks                      ShareLink[]                @relation("ShareLinkOwner")
  referralsGiven                  ReferralAttribution[]      @relation("ReferralReferrer")
  referralsReceived               ReferralAttribution[]      @relation("ReferralReferredUser")
  clientAttribution               ClientAttribution?
  byocClientLinks                 ClientPractitionerLink[]   @relation("ClientByocLinks")
  byocInviteVisits                PractitionerInviteVisit[]
  channelAttributions             ChannelAttribution[]
  supportConversations            SupportConversation[]
  bookingWaitlistEntries          BookingWaitlistEntry[]
  companionChatSessions           CompanionChatSession[]
  approvedManagementSpecialOrders ManagementSpecialOrder[]

  @@index([provider, providerId])
  @@index([email, provider])
  @@index([normalizedEmail])
  @@map("users")
}

enum Role {
  CLIENT
  PRACTITIONER
  ADMIN // Базовый администратор: одобрение практиков, работа с жалобами
  SUPERADMIN // Полный доступ: система, выплаты, все данные, метрики
}

// ─── Practitioners ────────────────────────────────────────────────────────────

model Practitioner {
  id     String @id @default(cuid())
  slug   String @unique @default("pending") // "anna-ivanova", "elena-petrova-2"
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status                  PractitionerStatus          @default(PENDING)
  title                   String // "Таролог · Астролог"
  bio                     String
  experience              String // "5 лет"
  pricePerSession         Int // RUB
  sessionDuration         Int                         @default(60) // минут: 30, 45, 60, 90
  commissionPercent       Int                         @default(35) // effective % комиссии платформы
  baseCommissionPercent   Int                         @default(35)
  commissionOverride      Int?
  commissionSource        String                      @default("base") // base | subscription_pro | subscription_pro_plus | override
  commissionSyncedAt      DateTime?
  byocCommissionPercent   Int                         @default(14)
  isFoundingCohort        Boolean                     @default(false)
  foundingUntil           DateTime?
  languages               String[]                    @default(["Русский"])
  verified                Boolean                     @default(false)
  verifiedAt              DateTime? // V9: timestamp when verification was approved
  agentOfferAcceptedAt    DateTime?                   @map("agent_offer_accepted_at")
  agentOfferVersion       String?                     @map("agent_offer_version")
  taxStatus               PractitionerTaxStatus       @default(UNKNOWN) @map("tax_status")
  taxReviewStatus         PractitionerTaxReviewStatus @default(PENDING) @map("tax_review_status")
  taxStatusVerifiedAt     DateTime?                   @map("tax_status_verified_at")
  taxStatusRejectedReason String?                     @map("tax_status_rejected_reason")
  founding                Boolean                     @default(false)
  riskScore               Int                         @default(0) @map("risk_score")
  riskFlags               String[]                    @default([]) @map("risk_flags")
  riskReviewedAt          DateTime?                   @map("risk_reviewed_at")
  specialties             Specialty[]
  categories              String[]                    @default([]) // W3: level-1 taxonomy ids (psychology, coaching, legal, finance, esoteric, joint)
  directions              String[]                    @default([]) // W3: level-2 taxonomy ids (cbt, gestalt, family-law, tarot…)
  tags                    String[]                    @default([]) // W3: level-3 задачи (тревога, развод, инвестиции…)

  // Рейтинг (денормализован для скорости)
  ratingSum     Float     @default(0)
  reviewCount   Int       @default(0)
  sessionCount  Int       @default(0)
  // B359 / Интерфейс 11: when the practitioner last opened /practitioner/reviews.
  // The sidebar «новых отзывов» badge counts reviews created after this, so it
  // resets to 0 once they've been seen (was a rolling 14-day window that never
  // cleared). NULL = never opened → fall back to a 14-day window.
  reviewsSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  slots                  TimeSlot[]
  bookings               Booking[]                @relation("BookingPractitioner")
  reviews                Review[]                 @relation("ReviewPractitioner")
  scheduleRules          ScheduleRule[]
  blockedSlots           BlockedSlot[]
  priceRates             PriceRate[]
  payouts                Payout[]
  payoutDetails          PayoutDetails?
  agentReports           AgentReport[]
  invites                PractitionerInvite[]
  byocClientLinks        ClientPractitionerLink[]
  clientAttributions     ClientAttribution[]      @relation("ClientAttributionPractitioner")
  referredBookings       Booking[]                @relation("BookingReferrerPractitioner")
  bookingWaitlistEntries BookingWaitlistEntry[]

  @@map("practitioners")
}

// ─── Practitioner Schedule ────────────────────────────────────────────────────

// Стандартное расписание: когда практик работает по умолчанию
model ScheduleRule {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  dayOfWeek      Int // 0=вс, 1=пн, ... 6=сб
  startHour      Int // 0-23
  startMinute    Int          @default(0)
  endHour        Int
  endMinute      Int          @default(0)
  enabled        Boolean      @default(true)

  @@unique([practitionerId, dayOfWeek])
  @@index([practitionerId])
  @@map("schedule_rules")
}

// Заблокированные слоты (практик закрыл время)
model BlockedSlot {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  startAt        DateTime
  endAt          DateTime

  @@index([practitionerId, startAt])
  @@map("blocked_slots")
}

// ─── Price Rates ──────────────────────────────────────────────────────────────

// Тарифная сетка практика
model PriceRate {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  durationMin    Int // 15, 30, 45, 60, 90, 120
  priceRub       Int
  enabled        Boolean      @default(true)

  @@unique([practitionerId, durationMin])
  @@index([practitionerId])
  @@map("price_rates")
}

enum PractitionerStatus {
  PENDING // Заявка подана
  ACTIVE // Активен
  SUSPENDED // Приостановлен
  BLOCKED // Заблокирован
}

enum PractitionerTaxStatus {
  UNKNOWN
  SELF_EMPLOYED
  INDIVIDUAL_ENTREPRENEUR
  LEGAL_ENTITY
}

enum PractitionerTaxReviewStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum Specialty {
  TAROT
  ASTROLOGY
  NUMEROLOGY
  PSYCHIC
  RUNES
  DREAMS
}

// ─── Time Slots ───────────────────────────────────────────────────────────────

model TimeSlot {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  startAt         DateTime
  endAt           DateTime
  available       Boolean   @default(true)
  visibleFrom     DateTime? @map("visible_from")
  earlyAccessFrom DateTime? @map("early_access_from")

  booking         Booking?
  waitlistEntries BookingWaitlistEntry[]

  @@index([practitionerId, startAt])
  @@index([available, visibleFrom, earlyAccessFrom])
  @@map("time_slots")
}

// ─── Bookings ─────────────────────────────────────────────────────────────────

model Booking {
  id             String       @id @default(cuid())
  clientId       String
  client         User         @relation("BookingClient", fields: [clientId], references: [id])
  practitionerId String
  practitioner   Practitioner @relation("BookingPractitioner", fields: [practitionerId], references: [id])
  slotId         String?      @unique
  slot           TimeSlot?    @relation(fields: [slotId], references: [id])

  status                   BookingStatus @default(PENDING)
  priceRub                 Int
  // B379 (M26): «контекст встречи» — с чем клиент хочет разобраться. Задаётся
  // клиентом при первой записи к специалисту (перенос из диалога или ручной
  // ввод); виден только клиенту, назначенному специалисту и админам.
  meetingContext           String?       @map("meeting_context")
  source                   ClientSource  @default(PLATFORM)
  referrerPractitionerId   String?
  referrerPractitioner     Practitioner? @relation("BookingReferrerPractitioner", fields: [referrerPractitionerId], references: [id])
  commissionPercentApplied Int?
  priority                 Int           @default(0)
  paymentId                String?       @unique // ЮKassa / Stripe payment ID
  paymentMethod            String? // "yukassa" | "stripe"
  ipHash                   String?       @map("ip_hash")
  userAgentHash            String?       @map("user_agent_hash")
  deviceHash               String?       @map("device_hash")
  riskScore                Int           @default(0) @map("risk_score")
  riskFlags                String[]      @default([]) @map("risk_flags")
  riskReviewedAt           DateTime?     @map("risk_reviewed_at")

  // Видеосессия
  roomId    String? // LiveKit room ID
  startedAt DateTime?
  endedAt   DateTime?

  // Напоминания (cron)
  reminder24hSent Boolean @default(false)
  reminder1hSent  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review                  Review?
  videoSession            VideoSession?
  complaints              Complaint[]
  payment                 Payment?
  payouts                 Payout[]
  promotedWaitlistEntries BookingWaitlistEntry[] @relation("WaitlistPromotedBooking")

  @@index([clientId])
  @@index([practitionerId])
  @@index([source, createdAt])
  @@index([referrerPractitionerId, createdAt])
  @@index([ipHash, createdAt])
  @@index([deviceHash, createdAt])
  @@index([riskScore, createdAt])
  @@index([priority, createdAt])
  @@map("bookings")
}

enum ClientSource {
  PLATFORM
  BYOC
}

enum BookingStatus {
  PENDING // Ожидает подтверждения
  CONFIRMED // Подтверждена
  IN_PROGRESS // Сессия идёт
  COMPLETED // Завершена, деньги удержаны
  CANCELLED // Отменена
  DISPUTED // Жалоба подана
  REFUNDED // Возврат
  EXPIRED // Пропущена (не явился)
}

enum WaitlistStatus {
  ACTIVE
  PROMOTED
  CANCELLED
  EXPIRED
}

model BookingWaitlistEntry {
  id                String         @id @default(cuid())
  clientId          String
  client            User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  practitionerId    String
  practitioner      Practitioner   @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  slotId            String?
  slot              TimeSlot?      @relation(fields: [slotId], references: [id], onDelete: SetNull)
  startAt           DateTime       @map("start_at")
  endAt             DateTime       @map("end_at")
  status            WaitlistStatus @default(ACTIVE)
  priority          Int            @default(0)
  planKey           String?        @map("plan_key")
  promotedBookingId String?        @map("promoted_booking_id")
  promotedBooking   Booking?       @relation("WaitlistPromotedBooking", fields: [promotedBookingId], references: [id], onDelete: SetNull)
  promotedAt        DateTime?      @map("promoted_at")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  @@unique([clientId, practitionerId, startAt, endAt, status], map: "booking_waitlist_client_window_status_key")
  @@index([clientId, status, startAt])
  @@index([practitionerId, status, startAt, priority, createdAt])
  @@index([slotId, status, priority, createdAt])
  @@index([promotedBookingId])
  @@map("booking_waitlist_entries")
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id             String       @id @default(cuid())
  bookingId      String       @unique
  booking        Booking      @relation(fields: [bookingId], references: [id])
  authorId       String
  author         User         @relation("ReviewAuthor", fields: [authorId], references: [id])
  practitionerId String
  practitioner   Practitioner @relation("ReviewPractitioner", fields: [practitionerId], references: [id])

  rating    Int // 1-5
  text      String?
  status    String   @default("PUBLISHED") // PUBLISHED | REVIEW | HIDDEN
  riskScore Int      @default(0) @map("risk_score")
  riskFlags String[] @default([]) @map("risk_flags")
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([practitionerId])
  @@index([status, createdAt])
  @@index([riskScore, createdAt])
  @@map("reviews")
}

// ─── Video Sessions & Chat ────────────────────────────────────────────────────

model VideoSession {
  id                             String      @id @default(cuid())
  bookingId                      String      @unique
  booking                        Booking     @relation(fields: [bookingId], references: [id])
  roomName                       String      @unique // LiveKit room name
  status                         VideoStatus @default(WAITING)
  startedAt                      DateTime?
  endedAt                        DateTime?
  recordingUrl                   String? // path to recording file
  recordingExpiry                DateTime? // 24h TTL
  recordingEgressId              String?     @map("recording_egress_id")
  recordingConsentClientAt       DateTime?   @map("recording_consent_client_at")
  recordingConsentPractitionerAt DateTime?   @map("recording_consent_practitioner_at")
  serverSttStatus                String      @default("not_requested") @map("server_stt_status")
  serverSttJobId                 String?     @map("server_stt_job_id")
  serverSttEgressId              String?     @map("server_stt_egress_id")
  serverSttAudioUrl              String?     @map("server_stt_audio_url")
  serverSttAudioExpiresAt        DateTime?   @map("server_stt_audio_expires_at")
  transcriptText                 String? // full transcript after session
  summaryText                    String? // AI summary for practitioner
  clientFollowupDraft            String?     @map("client_followup_draft")
  practitionerNotesText          String?     @map("practitioner_notes_text")
  transcriptMetadata             Json?       @map("transcript_metadata")
  summaryMetadata                Json?       @map("summary_metadata")
  transcriptExpiresAt            DateTime?   @map("transcript_expires_at")
  summaryExpiresAt               DateTime?   @map("summary_expires_at")
  complianceStatus               String      @default("not_reviewed") @map("compliance_status")
  complianceRiskScore            Int         @default(0) @map("compliance_risk_score")
  complianceEvidence             Json?       @map("compliance_evidence")
  complianceEvidenceExpiresAt    DateTime?   @map("compliance_evidence_expires_at")
  complianceReviewedAt           DateTime?   @map("compliance_reviewed_at")
  createdAt                      DateTime    @default(now())

  messages ChatMessage[]

  @@index([bookingId])
  @@index([recordingEgressId])
  @@index([complianceStatus, complianceRiskScore])
  @@index([serverSttStatus])
  @@index([transcriptExpiresAt])
  @@index([summaryExpiresAt])
  @@index([complianceEvidenceExpiresAt])
  @@index([serverSttAudioExpiresAt])
  @@map("video_sessions")
}

enum VideoStatus {
  WAITING // room created, not started
  ACTIVE // session in progress
  ENDED // session finished
  RECORDING // post-processing recording
}

model ChatMessage {
  id             String       @id @default(cuid())
  videoSessionId String
  videoSession   VideoSession @relation(fields: [videoSessionId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  text           String?
  fileUrl        String? // uploaded file path
  fileName       String?
  fileMime       String?
  createdAt      DateTime     @default(now())

  @@index([videoSessionId, createdAt])
  @@map("chat_messages")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String // actor (who did it)
  targetId  String? // target user id
  action    String // LOGIN, LOGOUT, PROFILE_UPDATE, PASSWORD_RESET, etc.
  details   String? // JSON details
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([targetId, createdAt])
  @@map("audit_logs")
}

// ─── Cross-Border AI Legal Controls ──────────────────────────────────────────

model ManagementSpecialOrder {
  id               String                       @id @default(cuid())
  orderNumber      String                       @unique @map("order_number")
  orderDate        DateTime                     @map("order_date")
  initiator        String
  reason           String                       @db.Text
  legalBasis       String                       @map("legal_basis") @db.Text
  riskAssessment   String                       @map("risk_assessment") @db.Text
  allowedProviders AIProvider[]                 @default([]) @map("allowed_providers")
  allowedScenarios String[]                     @default([]) @map("allowed_scenarios")
  validFrom        DateTime                     @map("valid_from")
  validTo          DateTime                     @map("valid_to")
  status           ManagementSpecialOrderStatus @default(DRAFT)
  approvedById     String?                      @map("approved_by")
  approvedBy       User?                        @relation(fields: [approvedById], references: [id], onDelete: SetNull)
  createdAt        DateTime                     @default(now()) @map("created_at")
  updatedAt        DateTime                     @updatedAt @map("updated_at")

  @@index([status, validFrom, validTo])
  @@map("management_special_orders")
}

model ForeignProviderRegistry {
  id                      String                        @id @default(cuid())
  providerNameInternal    String                        @unique @map("provider_name_internal")
  providerCategory        String                        @map("provider_category")
  countryOrRegion         String                        @map("country_or_region")
  role                    String
  potentialDataCategories String[]                      @default([]) @map("potential_data_categories")
  status                  ForeignProviderRegistryStatus @default(INACTIVE_FOR_RU)
  legalBasis              String?                       @map("legal_basis") @db.Text
  dpaStatus               String?                       @map("dpa_status")
  termsReviewStatus       String?                       @map("terms_review_status")
  rknCrossBorderStatus    String?                       @map("rkn_cross_border_status")
  lastReviewedAt          DateTime?                     @map("last_reviewed_at")
  createdAt               DateTime                      @default(now()) @map("created_at")
  updatedAt               DateTime                      @updatedAt @map("updated_at")

  @@index([status, providerCategory])
  @@map("foreign_provider_registry")
}

enum ManagementSpecialOrderStatus {
  DRAFT
  ACTIVE
  REVOKED
  EXPIRED
}

enum ForeignProviderRegistryStatus {
  ACTIVE
  INACTIVE_FOR_RU
  INACTIVE_FOR_RU_PROMPTS
  BLOCKED
  FUTURE
}

// ─── Durable Jobs ────────────────────────────────────────────────────────────

model Job {
  id             String    @id @default(cuid())
  queue          String    @default("default")
  type           String
  status         JobStatus @default(PENDING)
  priority       Int       @default(0)
  payload        Json
  result         Json?
  error          String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  runAfter       DateTime  @default(now()) @map("run_after")
  lockedAt       DateTime? @map("locked_at")
  lockedBy       String?   @map("locked_by")
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  idempotencyKey String?   @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([queue, type, idempotencyKey], map: "jobs_queue_type_idempotency_key_key")
  @@index([status, runAfter, priority, createdAt])
  @@index([queue, status, runAfter])
  @@index([lockedAt])
  @@map("jobs")
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

// ─── External Webhooks ────────────────────────────────────────────────────────

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  resourceId  String?
  status      String    @default("PROCESSING")
  payload     Json?
  result      Json?
  error       String?
  requestId   String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([provider, receivedAt])
  @@index([provider, resourceId])
  @@map("webhook_events")
}

// ─── Moderator Permissions ────────────────────────────────────────────────────

model ModeratorPermission {
  id          String  @id @default(cuid())
  moderatorId String
  permission  String // e.g. "clients.view", "clients.edit", "practitioners.create"
  granted     Boolean @default(true)

  @@unique([moderatorId, permission])
  @@map("moderator_permissions")
}

// ─── User Block ───────────────────────────────────────────────────────────────

// blockedAt stored in User.deletedAt reuse OR separate field
// Using a separate simple approach: add blocked flag to User

// ─── Complaints ──────────────────────────────────────────────────────────────

model Complaint {
  id          String          @id @default(cuid())
  bookingId   String
  booking     Booking         @relation(fields: [bookingId], references: [id])
  reportedBy  String
  reporter    User            @relation("ComplaintReporter", fields: [reportedBy], references: [id])
  reason      ComplaintReason
  description String
  status      String          @default("OPEN") // OPEN | REVIEWING | RESOLVED | CLOSED
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([bookingId])
  @@index([status, createdAt])
  @@map("complaints")
}

enum ComplaintReason {
  PRACTITIONER_NO_SHOW // Практик не явился
  ETHICAL_VIOLATION // Нарушение этического кодекса
  MANIPULATION // Запугивание/манипуляции
  TECHNICAL_ISSUE // Технический сбой
  EARLY_TERMINATION // Сессия закончилась раньше времени
  PAYMENT_ISSUE // Проблема с оплатой
  OTHER // Другое
}

// ─── Notifications ────────────────────────────────────────────────────────────

// Какие уведомления получать и через какой канал
model NotificationPreference {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  event             NotificationEvent
  channel           NotificationChannel
  enabled           Boolean             @default(true)
  // Для событий типа "напомни за N часов"
  remindBeforeHours Int? // null = нет напоминания, 24 = за сутки, 1 = за час

  @@unique([userId, event, channel])
  @@index([userId])
  @@map("notification_preferences")
}

enum NotificationEvent {
  BOOKING_REQUESTED // Новое бронирование (для практика)
  BOOKING_CONFIRMED // Бронирование подтверждено (для клиента)
  BOOKING_CANCELLED // Бронирование отменено
  BOOKING_REMINDER // Напоминание о предстоящей сессии
  SESSION_STARTED // Сессия началась
  SESSION_COMPLETED // Сессия завершена
  REVIEW_REQUESTED // Просьба оставить отзыв
  NEW_REVIEW // Новый отзыв (для практика)
  PAYMENT_RECEIVED // Платёж получен
  PAYOUT_SCHEDULED // Запланированная выплата практикам (для superadmin)
  BALANCE_TOPUP // Пополнение баланса (для клиента/практика)
  PRODUCT_UNLOCKED // Платный продукт открыт
  SUBSCRIPTION_STARTED // Подписка активирована
  SUBSCRIPTION_RENEWAL // Скоро автопродление подписки (за 3 дня)
  SUBSCRIPTION_CANCELLED // Подписка отменена
  SUBSCRIPTION_PAYMENT_FAILED // Платеж подписки не прошел
  CARD_LINKED // Новая карта привязана
  CARD_REMOVED // Карта отвязана
  DAILY_CARD // Ежедневная карта ясности
  ABANDONED_CHECKOUT // Незавершенная оплата
  REPORT_READY // Платный отчет готов
  PARTNER_COMPLETED // Второй участник завершил свою часть
  CIRCLE_READY // Круг ясности готов
  ROUTE_REMINDER // Напоминание по маршруту ясности
  WEEKLY_DIGEST // Недельный дайджест клиента
  PRACTITIONER_DIGEST // Дайджест специалиста
  COMPLIANCE_ALERT // Комплаенс-сигнал для админа/модератора
  CREDITS_EXPIRING // Кредиты скоро сгорят
  STREAK_AT_RISK // Практический стрик под риском
  MOMENT_OF_NEED // Мягкое возвращение в момент нужды
  WELCOME_CREDITS // Приветственные кредиты начислены
  WELCOME_CREDITS_REMINDER // Напоминание о приветственных кредитах
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
  WEB // Уведомление в дропдауне кабинета (колокольчик)
}

// Запись событий для WEB-канала: показываются в дропдауне колокольчика.
model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     NotificationEvent
  title     String
  body      String
  href      String? // deep-link
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model DailyCard {
