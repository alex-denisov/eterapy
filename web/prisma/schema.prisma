model ProductEntitlement {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  productKey    String
  source        String    @default("purchase") // purchase | subscription | trial | manual | refund_restore
  status        String    @default("ACTIVE") // ACTIVE | REVOKED | EXPIRED | REFUNDED
  transactionId String?
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  consumedAt    DateTime?
  revokedAt     DateTime?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, status, productKey])
  @@index([transactionId])
  @@index([validUntil])
  @@map("product_entitlements")
}

model UserSubscription {
  id                     String    @id @default(cuid())
  userId                 String
  user                   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey                String
  status                 String    @default("TRIALING") // TRIALING | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  provider               String    @default("yookassa")
  providerSubscriptionId String?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean   @default(false)
  cancelledAt            DateTime?
  // B348 / Механика 1: timestamp of the last 3-day auto-renewal reminder sent
  // for the CURRENT period. Compared against currentPeriodStart so each period
  // is reminded at most once. NULL = not yet reminded this period.
  renewalReminderAt      DateTime?
  metadata               Json?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([userId, status])
  @@index([planKey, status])
  @@index([providerSubscriptionId])
  @@index([status, currentPeriodEnd])
  @@map("user_subscriptions")
}

