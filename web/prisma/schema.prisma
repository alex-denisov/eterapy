enum ComplaintReason {
  PRACTITIONER_NO_SHOW // Практик не явился
  ETHICAL_VIOLATION // Нарушение этического кодекса
  MANIPULATION // Запугивание/манипуляции
  TECHNICAL_ISSUE // Технический сбой
  EARLY_TERMINATION // Сессия закончилась раньше времени
  PAYMENT_ISSUE // Проблема с оплатой
  OTHER // Другое
}

// ─── Notifications ────────────────────────────────────────────────────────────

// Какие уведомления получать и через какой канал
/**
 * B599 · Журнал маркетинговых отправок.
 *
 * Владелец: «где будет видно кому, когда, куда и что было отправлено… и чтобы я
 * видел текст, который ушел пользователю».
 *
 * Тело хранится СНИМКОМ на момент отправки, а не собирается заново при
 * просмотре: шаблон правится, а вопрос «что ушло» — про прошлое. Пересборка при
 * открытии показывала бы сегодняшний текст под вчерашней датой.
 *
 * Заблокированные попытки пишутся сюда ТОЖЕ, с причиной. «Не ушло» без записи —
 * это молчание, из-за которого полгода не замечали неработающий cron.
 */
model MarketingDispatch {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventKey  String   @map("event_key") // ключ из lib/marketing/events.ts
  category  String // категория оттуда же — по ней владелец фильтрует
  channel   String // email / telegram / push
  status    String // sent | blocked | failed
  blockedBy String?  @map("blocked_by") // причина отказа, если status = blocked
  subject   String?
  body      String? // отрендеренное тело КАК ОНО УШЛО
  error     String?
  createdAt DateTime @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")

  @@index([userId, createdAt])
  @@index([eventKey, createdAt])
  @@index([status, createdAt])
  @@map("marketing_dispatches")
}

/// B599 (батч №20) · Журнал СЛУЖЕБНЫХ отправок: кому, когда, куда и что ушло.
///
/// Тело письма — снимок на момент отправки. Для АККАУНТНЫХ писем (сброс пароля,
/// подтверждение почты) тело НЕ пишется намеренно: в нём одноразовая ссылка, а
/// журнал читает суперадмин. Иначе доступ к журналу означал бы возможность
/// сменить пароль любому пользователю.
model NotificationDispatch {
  id        String   @id @default(cuid())
  /// NULL для писем на адрес, за которым аккаунта может не быть (приглашения).
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Адрес доставки в том виде, в каком его увидел отправитель.
  recipient String
  /// Ключ события: NotifEvent или ACCOUNT_* из notifications/system-catalog.ts
  event     String
  /// notify | account — через настройки кабинета или мимо них
  kind      String
  channel   String
  status    String // sent | failed
  subject   String?
  body      String?
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([createdAt])
  @@map("notification_dispatches")
}

model NotificationPreference {
  id                String              @id @default(cuid())
  userId            String
  user              User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  event             NotificationEvent
  channel           NotificationChannel
  enabled           Boolean             @default(true)
  // Для событий типа "напомни за N часов"
  remindBeforeHours Int? // null = нет напоминания, 24 = за сутки, 1 = за час

  @@unique([userId, event, channel])
  @@index([userId])
  @@map("notification_preferences")
}

enum NotificationEvent {
  BOOKING_REQUESTED // Новое бронирование (для практика)
  BOOKING_CONFIRMED // Бронирование подтверждено (для клиента)
  BOOKING_CANCELLED // Бронирование отменено
  BOOKING_REMINDER // Напоминание о предстоящей сессии
  SESSION_STARTED // Сессия началась
  SESSION_COMPLETED // Сессия завершена
  REVIEW_REQUESTED // Просьба оставить отзыв
  NEW_REVIEW // Новый отзыв (для практика)
  PAYMENT_RECEIVED // Платёж получен
  PAYOUT_SCHEDULED // Запланированная выплата практикам (для superadmin)
  BALANCE_TOPUP // Пополнение баланса (для клиента/практика)
  PRODUCT_UNLOCKED // Платный продукт открыт
  SUBSCRIPTION_STARTED // Подписка активирована
  SUBSCRIPTION_RENEWAL // Скоро автопродление подписки (за 3 дня)
  SUBSCRIPTION_CANCELLED // Подписка отменена
  SUBSCRIPTION_PAYMENT_FAILED // Платеж подписки не прошел
  CARD_LINKED // Новая карта привязана
  CARD_REMOVED // Карта отвязана
  DAILY_CARD // Ежедневная карта ясности
  ABANDONED_CHECKOUT // Незавершенная оплата
  REPORT_READY // Платный отчет готов
  PARTNER_COMPLETED // Второй участник завершил свою часть
  CIRCLE_READY // Круг ясности готов
  ROUTE_REMINDER // Напоминание по маршруту ясности
  WEEKLY_DIGEST // Недельный дайджест клиента
  PRACTITIONER_DIGEST // Дайджест специалиста
  COMPLIANCE_ALERT // Комплаенс-сигнал для админа/модератора
  CREDITS_EXPIRING // Кредиты скоро сгорят
  STREAK_AT_RISK // Практический стрик под риском
  MOMENT_OF_NEED // Мягкое возвращение в момент нужды
  WELCOME_CREDITS // Приветственные кредиты начислены
  WELCOME_CREDITS_REMINDER // Напоминание о приветственных кредитах
  PRACTITIONER_MESSAGE // B478: сообщение/материал от специалиста (для клиента)
  BOOKING_PROPOSED // B480: специалист предложил время сессии (для клиента)
  BOOKING_CHANGE_REQUESTED // B481: запрос переноса/отмены (для другой стороны)
  BOOKING_CHANGE_RESOLVED // B481: запрос переноса/отмены согласован/отклонён
  GOODWILL_CREDITS // B484: компенсационные баллы клиенту за счёт платформы
  RELIABILITY_WARNING // B484: предупреждение практику о деприоритизации
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
  WEB // Уведомление в дропдауне кабинета (колокольчик)
}

// Запись событий для WEB-канала: показываются в дропдауне колокольчика.
model Notification {
  id        String            @id @default(cuid())
  userId    String
