generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                    String    @id @default(cuid())
  email                 String    @unique
  // B372 (M26): нормализованный e-mail для антифрода gmail-дублей
  // (точки и +suffix в local part у gmail/googlemail схлопываются).
  normalizedEmail       String?   @map("normalized_email")
  name                  String
  password              String
  role                  Role      @default(CLIENT)
  emailVerified         Boolean   @default(false)
  /// B571: суперадмин выдаёт признак «тестовые платежи». Такой пользователь
  /// платит по ТЕСТОВЫМ ключам Robokassa, но платформа обрабатывает платёж как
  /// настоящий — баллы, подписки и услуги начисляются. Нужно, чтобы люди могли
  /// участвовать в проверке рельса, не тратя денег. Снятие признака мгновенно
  /// возвращает пользователя на боевые ключи.
  testPaymentsEnabled   Boolean   @default(false) @map("test_payments_enabled")
  avatarUrl             String?
  deletedAt             DateTime? // deactivated at this time, anonymize after 7 days
  retentionAnonymizedAt DateTime? @map("retention_anonymized_at")
  blockedAt             DateTime? // blocked by admin — cannot login
  freeToolsLimit        Int? // null = plan default (3), 0 = unlimited
  verificationToken     String?   @unique
  verificationExpires   DateTime?
  resetToken            String?   @unique
  resetExpires          DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  /// Последняя наблюдаемая активность. «Последний вход» в суперадминке брался
  /// только из LOGIN-аудита, а он пишется лишь в момент самой аутентификации:
  /// при живой JWT-сессии человек ходит по сайту неделями, не создавая ни
  /// одного события, и столбец замирал на дате регистрации.
  lastSeenAt            DateTime? @map("last_seen_at")
  practiceStreakCount   Int       @default(0) @map("practice_streak_count")
  practiceStreakLongest Int       @default(0) @map("practice_streak_longest")
  practiceLastDoneDate  DateTime? @map("practice_last_done_date")

  // Identity
  provider            String? @default("web") // "vk", "google", "web", "mobile_web", "ios", "android", "manual", "telegram", "max"
  providerId          String? // ID from provider (e.g., VK user_id, Google sub)
  registrationChannel String? // "site", "google", "vk", "telegram", "referral" — откуда пришёл

  // Telegram
  telegramId       String? @unique // Telegram chat_id (set via bot)
  telegramUsername String? // @username

  // B599: согласие на РЕКЛАМНЫЕ рассылки. Отдельно от транзакционных настроек
  // намеренно: по 38-ФЗ ст. 18 реклама требует предварительного согласия, и
  // переиспользовать под неё галочку «присылать уведомления о записи» нельзя.
  // Отписка хранится своим полем и всегда сильнее согласия — см. lib/marketing/gates.ts.
  marketingConsentAt     DateTime? @map("marketing_consent_at")
  marketingConsentSource String?   @map("marketing_consent_source") // где именно человек согласился
  marketingOptOutAt      DateTime? @map("marketing_opt_out_at")

  // B681: человек убрал блок «карта дня» с первого экрана кабинета и мини-аппа.
  // Отдельная колонка, а не канал WEB события DAILY_CARD: тот канал уже
  // управляет записью психологической «Ежедневной практики» в колокольчике, и
  // один тумблер на две разные вещи скрыл бы заодно её. Вернуть показ можно
  // только в «Настройки → Уведомления» — так просил владелец.
  tarotDayHidden Boolean @default(false) @map("tarot_day_hidden")

  // Extended profile (for AI personalization)
  birthDate       DateTime?
  birthDateSource String?   @map("birth_date_source")
  birthTime       String? // "14:30" — for natal chart
  birthPlace      String? // city name
  timezone        String? // e.g. "Europe/Moscow"
  maritalStatus   String? // single/married/divorced/etc
  occupation      String?
  aiGoals         String[]  @default([]) // career/relationships/selfdev/health/etc

  // Relations
  practitioner                    Practitioner?
  bookingsAsClient                Booking[]                   @relation("BookingClient")
  toolSessions                    ToolSession[]
  reviewsWritten                  Review[]                    @relation("ReviewAuthor")
  storedFiles                     StoredFile[]
  chatMessages                    ChatMessage[]
  notificationPrefs               NotificationPreference[]
  marketingDispatches             MarketingDispatch[]
  notificationDispatches          NotificationDispatch[]
  notifications                   Notification[]
  complaints                      Complaint[]                 @relation("ComplaintReporter")
  aiSessionLogs                   AISessionLog[]
  aiGatewayRequests               AIRequest[]
  dialogues                       Dialogue[]
  productResults                  ProductResult[]
  transactions                    Transaction[]
  savedCards                      SavedCard[]
  entitlements                    ProductEntitlement[]
  subscriptions                   UserSubscription[]
  creditLedgerEntries             CreditLedgerEntry[]
  clarityCreditLedgerEntries      ClarityCreditLedgerEntry[]
  compatibilitiesCreated          Compatibility[]             @relation("CompatibilityCreator")
  compatibilitiesJoined           Compatibility[]             @relation("CompatibilityPartner")
  clarityCirclesCreated           ClarityCircle[]             @relation("ClarityCircleCreator")
  clarityCircleParticipations     ClarityCircleParticipant[]
  clarityRoutes                   ClarityRoute[]
  dailyCards                      DailyCard[]
  missionProgresses               MissionProgress[]
  shareLinks                      ShareLink[]                 @relation("ShareLinkOwner")
  referralsGiven                  ReferralAttribution[]       @relation("ReferralReferrer")
  referralsReceived               ReferralAttribution[]       @relation("ReferralReferredUser")
  clientAttribution               ClientAttribution?
  byocClientLinks                 ClientPractitionerLink[]    @relation("ClientByocLinks")
  byocInviteVisits                PractitionerInviteVisit[]
  channelAttributions             ChannelAttribution[]
  supportConversations            SupportConversation[]
  bookingWaitlistEntries          BookingWaitlistEntry[]
  companionChatSessions           CompanionChatSession[]
  approvedManagementSpecialOrders ManagementSpecialOrder[]
  consentLogs                     ConsentLog[]
  platformIdentities              PlatformIdentity[]
  miniAppAuthGrants               MiniAppAuthGrant[]
  // B466 practitioner platform (B478/B480 + план сопровождения)
  practitionerMessages            PractitionerClientMessage[] @relation("PractitionerMessageClient")
  carePlansAsClient               ClientCarePlan[]            @relation("CarePlanClient")
  bookingProposals                BookingProposal[]           @relation("BookingProposalClient")

  @@index([provider, providerId])
  @@index([email, provider])
  @@index([normalizedEmail])
  @@map("users")
}

enum Role {
  CLIENT
  PRACTITIONER
  ADMIN // Базовый администратор: одобрение практиков, работа с жалобами
  SUPERADMIN // Полный доступ: система, выплаты, все данные, метрики
}

// B427 (M28): explicit, versioned consent capture at registration. Two separate
// checkboxes (contract package + personal-data consent) are logged as distinct
// records with the document versions, consent version, IP and user-agent.
enum ConsentCheckboxType {
  CONTRACT
  PDN
}

model ConsentLog {
  id               String              @id @default(cuid())
  userId           String
  checkboxType     ConsentCheckboxType
  documentVersions Json
  consentVersion   String
  ipAddress        String?
  userAgent        String?
  createdAt        DateTime            @default(now())
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("consent_logs")
}

// ─── Practitioners ────────────────────────────────────────────────────────────

model Practitioner {
  id     String @id @default(cuid())
  slug   String @unique @default("pending") // "anna-ivanova", "elena-petrova-2"
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status                  PractitionerStatus          @default(PENDING)
  title                   String // "Таролог · Астролог"
  bio                     String
  experience              String // "5 лет"
  pricePerSession         Int // RUB
  sessionDuration         Int                         @default(60) // минут: 30, 45, 60, 90
  commissionPercent       Int                         @default(35) // effective % комиссии платформы
  baseCommissionPercent   Int                         @default(35)
  commissionOverride      Int?
  commissionSource        String                      @default("base") // base | subscription_pro | subscription_pro_plus | override
  commissionSyncedAt      DateTime?
  byocCommissionPercent   Int                         @default(14)
  isFoundingCohort        Boolean                     @default(false)
  foundingUntil           DateTime?
  languages               String[]                    @default(["Русский"])
  verified                Boolean                     @default(false)
  verifiedAt              DateTime? // V9: timestamp when verification was approved
  // B459: superadmin-only manual booking-enable override. Bypasses the COMMERCIAL
  // gate (agent offer + tax status + payout requisites) for vetted/demo accounts so
  // a «Проверен ETerapy» practitioner is bookable; never bypasses the active check.
  bookingOverrideEnabled  Boolean                     @default(false) @map("booking_override_enabled")
  bookingOverrideAt       DateTime?                   @map("booking_override_at")
  // B584 (owner 2026-07-26): профиль-витрина, а не живой специалист. Сидированные
  // аккаунты нужны каталогу, но записаться к ним нельзя: за ними никого нет.
  // Флаг сильнее `bookingOverrideEnabled` — иначе он же их и открыл (B459 ставил
  // override именно демо-аккаунтам). Живой специалист создаётся с `false`, то
  // есть подключение реального человека кодом не сопровождается.
  demoAccount             Boolean                     @default(false) @map("demo_account")
  // B676 (владелец 2026-08-05): дата, РАНЬШЕ которой записаться нельзя.
  // Расписание в системе — недельные правила без дат, слоты считаются на лету,
  // поэтому «открыть запись с 10 сентября» иначе выражается только
  // блокировками до бесконечности. `null` — ограничения нет.
  bookableFrom            DateTime?                   @map("bookable_from")
  agentOfferAcceptedAt    DateTime?                   @map("agent_offer_accepted_at")
  agentOfferVersion       String?                     @map("agent_offer_version")
  taxStatus               PractitionerTaxStatus       @default(UNKNOWN) @map("tax_status")
  taxReviewStatus         PractitionerTaxReviewStatus @default(PENDING) @map("tax_review_status")
  taxStatusVerifiedAt     DateTime?                   @map("tax_status_verified_at")
  taxStatusRejectedReason String?                     @map("tax_status_rejected_reason")
  // B466/B483: ИНН вводится и проверяется ТОЛЬКО на «Налоговый статус»
  // (12 цифр самозанятый/ИП · 10 юр.лицо); показывается полностью.
  inn                     String?                     @map("inn")
  // B466/B434: делать AI-разбор сессии автоматически (per-session override
  // живёт на Booking.aiAnalysisEnabled).
  aiAutoAnalyze           Boolean                     @default(true) @map("ai_auto_analyze")
  // B434: авто-докупка минимального пакета при исчерпании квоты (default OFF).
  aiAutoTopup             Boolean                     @default(false) @map("ai_auto_topup")
  founding                Boolean                     @default(false)
  riskScore               Int                         @default(0) @map("risk_score")
  riskFlags               String[]                    @default([]) @map("risk_flags")
  riskReviewedAt          DateTime?                   @map("risk_reviewed_at")
  specialties             Specialty[]
  categories              String[]                    @default([]) // W3: level-1 taxonomy ids (psychology, coaching, legal, finance, esoteric, joint)
  directions              String[]                    @default([]) // W3: level-2 taxonomy ids (cbt, gestalt, family-law, tarot…)
  tags                    String[]                    @default([]) // W3: level-3 задачи (тревога, развод, инвестиции…)
  // B466/B480: предлагаемые форматы сессий (session-formats.ts: individual/
  // couple/family). individual всегда доступен; на цену не влияет.
  formats                 String[]                    @default(["individual"])

  // Рейтинг (денормализован для скорости)
  ratingSum     Float     @default(0)
  reviewCount   Int       @default(0)
  sessionCount  Int       @default(0)
  // B359 / Интерфейс 11: when the practitioner last opened /practitioner/reviews.
  // The sidebar «новых отзывов» badge counts reviews created after this, so it
  // resets to 0 once they've been seen (was a rolling 14-day window that never
  // cleared). NULL = never opened → fall back to a 14-day window.
  reviewsSeenAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  slots                  TimeSlot[]
  bookings               Booking[]                   @relation("BookingPractitioner")
  reviews                Review[]                    @relation("ReviewPractitioner")
  scheduleRules          ScheduleRule[]
  blockedSlots           BlockedSlot[]
  priceRates             PriceRate[]
  payouts                Payout[]
  payoutDetails          PayoutDetails?
  agentReports           AgentReport[]
  invites                PractitionerInvite[]
  byocClientLinks        ClientPractitionerLink[]
  clientAttributions     ClientAttribution[]         @relation("ClientAttributionPractitioner")
  referredBookings       Booking[]                   @relation("BookingReferrerPractitioner")
  bookingWaitlistEntries BookingWaitlistEntry[]
  // B466 practitioner platform
  aiAnalyses             PractitionerAiAnalysis[]
  aiTopups               PractitionerAiTopup[]
  clientMessages         PractitionerClientMessage[]
  carePlans              ClientCarePlan[]
  bookingProposals       BookingProposal[]

  @@map("practitioners")
}

// ─── B466 practitioner platform ──────────────────────────────────────────────

// B434 — метеринг AI-разборов: одна строка на разобранную сессию. source =
// "included" (из месячной квоты тарифа) | "topup" (из докупленного пула).
// periodKey = МСК-месяц "2026-07".
model PractitionerAiAnalysis {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  videoSessionId String       @unique @map("video_session_id")
  source         String       @default("included")
  periodKey      String       @map("period_key")
  createdAt      DateTime     @default(now())

  @@index([practitionerId, periodKey])
  @@map("practitioner_ai_analyses")
}

// B434 — покупка пакета разборов (+10/+25/+50 = 790/1790/2990 ₽).
model PractitionerAiTopup {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  units          Int
  amountKopecks  Int          @map("amount_kopecks")
  transactionId  String?      @unique @map("transaction_id")
  createdAt      DateTime     @default(now())

  @@index([practitionerId, createdAt])
  @@map("practitioner_ai_topups")
}

// B478 — одностороннее «Сообщение клиенту»: сервисный АРТЕФАКТ, привязанный к
// клиенту (и опционально к сессии), НЕ инбокс/чат (ОРИ-safe: без ответной
// ветки; ответ клиента — на следующей сессии). Персистентно (не каскад с
// видеосессией). Клиент читает в «Сообщения» под «Ещё» и отмечает readAt.
model PractitionerClientMessage {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  clientId       String
  client         User         @relation("PractitionerMessageClient", fields: [clientId], references: [id], onDelete: Cascade)
  bookingId      String?      @map("booking_id") // сессия-контекст (без FK-каскада)
  text           String
  attachmentUrl  String?      @map("attachment_url")
  attachmentName String?      @map("attachment_name")
  sentAt         DateTime     @default(now()) @map("sent_at")
  readAt         DateTime?    @map("read_at")

  @@index([practitionerId, clientId, sentAt])
  @@index([clientId, readAt])
  @@map("practitioner_client_messages")
}

// B466 — «План сопровождения» (client-level CRM). goals = [{id, title,
// progress 0–100, status "new"|"active"|"done"}]. AI после сессии предлагает
// дельты в aiSuggestion — практик подтверждает/правит (owner: не авто).
model ClientCarePlan {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  clientId       String
  client         User         @relation("CarePlanClient", fields: [clientId], references: [id], onDelete: Cascade)
  goals          Json         @default("[]")
  methods        String[]     @default([])
  nextFocus      String[]     @default([]) @map("next_focus")
  aiSuggestion   Json?        @map("ai_suggestion")
  aiSuggestedAt  DateTime?    @map("ai_suggested_at")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([practitionerId, clientId])
  @@map("client_care_plans")
}

// B480 — «Записать»: практик предлагает клиенту слот → клиент получает
// уведомление, подтверждает и оплачивает (создаётся обычный Booking).
model BookingProposal {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  clientId       String
  client         User         @relation("BookingProposalClient", fields: [clientId], references: [id], onDelete: Cascade)
  startAt        DateTime     @map("start_at")
  durationMin    Int          @map("duration_min")
  priceRub       Int          @map("price_rub")
  message        String?
  // B466/B480: формат предлагаемой сессии (session-formats.ts). null → «individual».
  format         String?
  status         String       @default("PENDING") // PENDING|ACCEPTED|DECLINED|EXPIRED|CANCELLED
  bookingId      String?      @unique @map("booking_id")
  createdAt      DateTime     @default(now())
  resolvedAt     DateTime?    @map("resolved_at")

  @@index([practitionerId, status])
  @@index([clientId, status, createdAt])
  @@map("booking_proposals")
}

// B481 — запрос клиента/практика на перенос или отмену подтверждённой сессии.
// Перенос и отмена <24ч требуют согласования другой стороной; штраф <24ч может
// быть прощён практиком (penaltyWaived). Отмена практиком — без штрафа клиенту
// (B484: полный возврат + метрика надёжности).
model BookingChangeRequest {
  id                  String    @id @default(cuid())
  bookingId           String    @map("booking_id")
  booking             Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  initiatedBy         String    @map("initiated_by") // CLIENT|PRACTITIONER
  type                String // RESCHEDULE|CANCEL
  proposedStartAt     DateTime? @map("proposed_start_at")
  proposedDurationMin Int?      @map("proposed_duration_min")
  reason              String?
  penaltyApplies      Boolean   @default(false) @map("penalty_applies")
  penaltyWaived       Boolean   @default(false) @map("penalty_waived")
  status              String    @default("PENDING") // PENDING|APPROVED|DECLINED|EXPIRED|WITHDRAWN
  createdAt           DateTime  @default(now())
  resolvedAt          DateTime? @map("resolved_at")

  @@index([bookingId, status])
  @@index([status, createdAt])
  @@map("booking_change_requests")
}

// ─── Practitioner Schedule ────────────────────────────────────────────────────

// Стандартное расписание: когда практик работает по умолчанию
model ScheduleRule {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  dayOfWeek      Int // 0=вс, 1=пн, ... 6=сб
  startHour      Int // 0-23
  startMinute    Int          @default(0)
  endHour        Int
  endMinute      Int          @default(0)
  enabled        Boolean      @default(true)

  @@unique([practitionerId, dayOfWeek])
  @@index([practitionerId])
  @@map("schedule_rules")
}

// Заблокированные слоты (практик закрыл время)
model BlockedSlot {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  startAt        DateTime
  endAt          DateTime

  @@index([practitionerId, startAt])
  @@map("blocked_slots")
}

// ─── Price Rates ──────────────────────────────────────────────────────────────

// Тарифная сетка практика
model PriceRate {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  durationMin    Int // 15, 30, 45, 60, 90, 120
  priceRub       Int
  enabled        Boolean      @default(true)

  @@unique([practitionerId, durationMin])
  @@index([practitionerId])
  @@map("price_rates")
}

enum PractitionerStatus {
  PENDING // Заявка подана
  ACTIVE // Активен
  SUSPENDED // Приостановлен
  BLOCKED // Заблокирован
}

enum PractitionerTaxStatus {
  UNKNOWN
  SELF_EMPLOYED
  INDIVIDUAL_ENTREPRENEUR
  LEGAL_ENTITY
}

enum PractitionerTaxReviewStatus {
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum Specialty {
  TAROT
  ASTROLOGY
  NUMEROLOGY
  PSYCHIC
  RUNES
  DREAMS
}

// ─── Time Slots ───────────────────────────────────────────────────────────────

model TimeSlot {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  startAt         DateTime
  endAt           DateTime
  available       Boolean   @default(true)
  visibleFrom     DateTime? @map("visible_from")
  earlyAccessFrom DateTime? @map("early_access_from")

  booking         Booking?
  waitlistEntries BookingWaitlistEntry[]

  @@index([practitionerId, startAt])
  @@index([available, visibleFrom, earlyAccessFrom])
  @@map("time_slots")
}

// ─── Bookings ─────────────────────────────────────────────────────────────────

model Booking {
  id             String       @id @default(cuid())
  clientId       String
  client         User         @relation("BookingClient", fields: [clientId], references: [id])
  practitionerId String
  practitioner   Practitioner @relation("BookingPractitioner", fields: [practitionerId], references: [id])
  slotId         String?      @unique
  slot           TimeSlot?    @relation(fields: [slotId], references: [id])

  status                   BookingStatus @default(PENDING)
  priceRub                 Int
  // B379 (M26): «контекст встречи» — с чем клиент хочет разобраться. Задаётся
  // клиентом при первой записи к специалисту (перенос из диалога или ручной
  // ввод); виден только клиенту, назначенному специалисту и админам.
  meetingContext           String?       @map("meeting_context")
  source                   ClientSource  @default(PLATFORM)
  referrerPractitionerId   String?
  referrerPractitioner     Practitioner? @relation("BookingReferrerPractitioner", fields: [referrerPractitionerId], references: [id])
  commissionPercentApplied Int?
  priority                 Int           @default(0)
  paymentId                String?       @unique // ЮKassa / Stripe payment ID
  paymentMethod            String? // "yukassa" | "stripe"
  ipHash                   String?       @map("ip_hash")
  userAgentHash            String?       @map("user_agent_hash")
  deviceHash               String?       @map("device_hash")
  riskScore                Int           @default(0) @map("risk_score")
  riskFlags                String[]      @default([]) @map("risk_flags")
  riskReviewedAt           DateTime?     @map("risk_reviewed_at")

  // Видеосессия
  roomId    String? // LiveKit room ID
  startedAt DateTime?
  endedAt   DateTime?

  // Напоминания (cron)
  reminder24hSent Boolean @default(false)
  reminder1hSent  Boolean @default(false)

  // B466/B480: формат сессии (session-formats.ts). null → «individual».
  format            String?
  // B466/B434: per-session разбор on/off (null → practitioner.aiAutoAnalyze).
  aiAnalysisEnabled Boolean?  @map("ai_analysis_enabled")
  // B481/B484: кто и почему отменил (для правил штрафов и метрики надёжности).
  cancelledBy       String?   @map("cancelled_by") // CLIENT|PRACTITIONER|ADMIN
  cancelledAt       DateTime? @map("cancelled_at")
  cancelReason      String?   @map("cancel_reason")
  // B484: отмена случилась <24ч до начала. Снимок на момент отмены — slotId
  // отвязывается при отмене (Баг 14), пост-фактум «позднесть» не восстановить.
  lateCancel        Boolean   @default(false) @map("late_cancel")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  review                  Review?
  videoSession            VideoSession?
  complaints              Complaint[]
  payment                 Payment?
  payouts                 Payout[]
  promotedWaitlistEntries BookingWaitlistEntry[] @relation("WaitlistPromotedBooking")
  changeRequests          BookingChangeRequest[]

  @@index([clientId])
  @@index([practitionerId])
  @@index([source, createdAt])
  @@index([referrerPractitionerId, createdAt])
  @@index([ipHash, createdAt])
  @@index([deviceHash, createdAt])
  @@index([riskScore, createdAt])
  @@index([priority, createdAt])
  @@map("bookings")
}

enum ClientSource {
  PLATFORM
  BYOC
}

