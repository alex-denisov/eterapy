  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         FileKind
  path         String // /uploads/avatars/xxx.jpg  or  /uploads/docs/xxx.pdf
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  @@index([userId, kind])
  @@map("stored_files")
}

enum FileKind {
  AVATAR
  DOCUMENT // chat attachments
  REPORT // AI tool reports (human design, natal, etc.)
}

// ─── Practitioner Applications ───────────────────────────────────────────────

model PractitionerApplication {
  id              String    @id @default(cuid())
  name            String
  email           String
  telegram        String?
  specialties     String[]
  experience      String
  formats         String[]
  about           String
  why             String?
  portfolio       String?
  // Y5: uploaded verification documents (StoredFile URLs) + admin review meta.
  attachments     String[]  @default([])
  rejectionReason String?
  reviewedAt      DateTime?
  status          String    @default("PENDING") // PENDING | REVIEWING | APPROVED | REJECTED
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([email])
  @@index([status, createdAt])
  @@map("practitioner_applications")
}

// ─── Telegram Link Tokens ─────────────────────────────────────────────────────

model TelegramLinkToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("telegram_link_tokens")
}

// B528: login identity is deliberately separate from User.telegramId, which is
// a notification delivery binding. A platform subject can restore a first-party
// session only through its own validated Mini App launch flow.
model PlatformIdentity {
  id          String   @id @default(cuid())
  provider    String
  subjectId   String   @map("subject_id")
  userId      String   @map("user_id")
  username    String?
  displayName String?  @map("display_name")
  verifiedAt  DateTime @default(now()) @map("verified_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subjectId])
  @@unique([provider, userId])
  @@index([userId])
  @@map("platform_identities")
}

// One-time bridge from a validated Telegram launch to NextAuth Credentials.
// Only a hash is stored; raw initData and raw grant values never reach logs/DB.
model MiniAppAuthGrant {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @map("token_hash")
  launchHash String    @unique @map("launch_hash")
  provider   String
  subjectId  String    @map("subject_id")
  userId     String    @map("user_id")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([provider, subjectId])
  @@map("mini_app_auth_grants")
}

// ─── Payments ─────────────────────────────────────────────────────────────────

