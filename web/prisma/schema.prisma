/// B577: owned registry of brand publications on external platforms.
/// Status-like fields intentionally remain strings so a new channel or workflow
/// state does not require a PostgreSQL enum migration.
model ExternalPublication {
  id               String                      @id @default(cuid())
  key              String                      @unique
  platform         String
  channelName      String?                     @map("channel_name")
  title            String
  contentType      String                      @map("content_type")
  status           String                      @default("PLANNED")
  publicUrl        String?                     @unique @map("public_url")
  destinationUrl   String?                     @map("destination_url")
  mediaUrl         String?                     @map("media_url")
  utmSource        String?                     @map("utm_source")
  utmMedium        String?                     @map("utm_medium")
  utmCampaign      String?                     @map("utm_campaign")
  utmContent       String?                     @map("utm_content")
  targetQuery      String?                     @map("target_query")
  cluster          String?
  indexStatus      String                      @default("UNKNOWN") @map("index_status")
  publishedAt      DateTime?                   @map("published_at")
  lastIndexCheckAt DateTime?                   @map("last_index_check_at")
  nextReviewAt     DateTime?                   @map("next_review_at")
  notes            String?                     @db.Text
  source           String                      @default("ADMIN_UI")
  createdBy        String?                     @map("created_by")
  updatedBy        String?                     @map("updated_by")
  createdAt        DateTime                    @default(now()) @map("created_at")
  updatedAt        DateTime                    @updatedAt @map("updated_at")
  metrics          ExternalPublicationMetric[]

  // B589 фаза 1: реестр стал очередью. PLANNED → DRAFT → SCHEDULED → PUBLISHED
  // | FAILED. `autoPublish` по умолчанию false — черновик наружу сам не идёт.
  body             String?                     @db.Text
  scheduledFor     DateTime?                   @map("scheduled_for")
  autoPublish      Boolean                     @default(false) @map("auto_publish")
  attemptCount     Int                         @default(0) @map("attempt_count")
  lastError        String?                     @map("last_error")
  externalPostId   String?                     @map("external_post_id")
  /// Слот контент-плана. Уникален: генератор не должен занимать слот дважды.
  planSlot         String?                     @unique @map("plan_slot")
  /// B610: for an engagement draft, where and in reply to what it is intended.
  /// Public third-party post context supplied verbatim to the marketing writer.
  /// It must never contain internal ETerapy client or practitioner data.
  engagementTargetUrl String?                  @map("engagement_target_url")
  engagementTargetId String?                   @map("engagement_target_id")
  engagementTargetLabel String?                @map("engagement_target_label")
  engagementExcerpt String?                    @db.Text @map("engagement_excerpt")
  /// B616: conversational register chosen for this reply (см. engagement-tone).
  engagementTone   String?                     @map("engagement_tone")
  telegramReviewMessageId Int?                 @map("telegram_review_message_id")
  agentWriterProvider String?                  @map("agent_writer_provider")
  agentWriterModel String?                     @map("agent_writer_model")
  agentReviewerProvider String?                @map("agent_reviewer_provider")
  agentReviewerModel String?                   @map("agent_reviewer_model")
  agentReview         Json?                    @map("agent_review")
  agentReviewedAt     DateTime?                @map("agent_reviewed_at")
  /// B700: незавершённая стадия автора. Автор и редактор — две операции
  /// конвейера, а не одна: готовый текст автора ложится сюда ДО вызова
  /// редактора. Отказ редактора по 429 стоит одного вызова редактора, а не
  /// повторной оплаты уже написанного материала.
  agentWriterDraft    Json?                    @map("agent_writer_draft")
  agentWrittenAt      DateTime?                @map("agent_written_at")
  moderationDecisionBy String?                 @map("moderation_decision_by")
  moderationDecisionAt DateTime?               @map("moderation_decision_at")
  /// B618: строка — ответ на конкретное входящее. Уникальность в базе, а не в
  /// коде: повторная доставка того же webhook не может создать вторую реплику.
  inboundReplyToId String?                     @unique @map("inbound_reply_to_id")
  inboundReplyTo   MarketingInboundMessage?    @relation("MarketingInboundReply", fields: [inboundReplyToId], references: [id], onDelete: SetNull)
  /// B626: почему строка ушла в архив. Раньше причина пряталась в `lastError`
  /// машинным кодом (`SUPERSEDED_BY_B610_TWO_WEEK_PLAN`), и владелец видел
  /// «Архив» без объяснения. Отдельное поле не смешивает «почему архив» с
  /// «на чём упала последняя попытка».
  archiveReason    String?                     @map("archive_reason")
  /// B626: сколько раз строку возвращали в работу после технического отказа.
  /// Ограничитель: бесконечный автоперезапуск сжёг бы ёмкость на материале,
  /// который не чинится.
  recoveryCount    Int                         @default(0) @map("recovery_count")
  /// B645: сколько раз материал переносили в следующий слот, не выпустив.
  /// Отдельно от `recoveryCount`: тот отвечает на вопрос «сколько раз материал
  /// переписывали», этот — «сколько раз ему двигали время».
  deferralCount    Int                         @default(0) @map("deferral_count")

  @@index([status, scheduledFor])
  @@index([status, publishedAt])
  @@index([platform, publishedAt])
  @@index([indexStatus, lastIndexCheckAt])
  @@index([nextReviewAt])
  @@index([utmSource, utmCampaign])
  @@map("external_publications")
}

/// B618 — единая очередь входящего из соцсетей: комментарии к нашим
/// публикациям, упоминания бренда и сообщения сообщества.
///
/// Одна таблица, одна машина состояний: RECEIVED → DRAFTED → ANSWERED, плюс
/// ESCALATED (кризисная формулировка — только человек) и IGNORED (адресовано не
/// нам). Дедупликация обеспечена парой (platform, externalId), а «один ответ на
/// одно входящее» — уникальным `ExternalPublication.inboundReplyToId`, то есть
/// базой, а не последовательностью вызовов.
model MarketingInboundMessage {
  id           String    @id @default(cuid())
  platform     String
  /// COMMENT — комментарий к нашей публикации, MENTION — упоминание бренда,
  /// DIRECT — сообщение сообществу.
  kind         String
  externalId   String    @map("external_id")
  /// Наш пост/медиа/чат, внутри которого пришло входящее.
  threadId     String?   @map("thread_id")
  authorLabel  String?   @map("author_label")
  text         String    @db.Text
  permalink    String?
  status       String    @default("RECEIVED")
  /// Балл риска вреда по общей шкале платформы (`dialogue-safety`).
  harmScore    Int?      @map("harm_score")
  receivedAt   DateTime  @default(now()) @map("received_at")
  answeredAt   DateTime? @map("answered_at")
  lastError    String?   @map("last_error")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  reply        ExternalPublication? @relation("MarketingInboundReply")

  @@unique([platform, externalId])
  @@index([status, receivedAt])
  @@index([platform, receivedAt])
  @@map("marketing_inbound_messages")
}

/// B610: durable SEO/marketing findings. Production does not write Markdown
/// tracker files, so the service creates a database ticket first; the admin
/// register and ops channel expose it for triage/export into the local board.
/// B626 — суточный срез поисковой аналитики.
///
/// Блоки на `/admin/marketing` собираются живыми запросами к Вебмастеру,
/// Метрике и Wordstat при каждом открытии страницы. Пока источник молчит (у
/// Яндекса одна страница в индексе), таблицы выглядят «незаполненными», и
/// отличить «данных нет» от «мы перестали спрашивать» по экрану невозможно.
/// Суточный срез делает движение наблюдаемым: у каждого дня есть отметка
/// времени, значения и разница с предыдущим днём.
model MarketingDailySnapshot {
  id          String   @id @default(cuid())
  /// Московская дата среза, `YYYY-MM-DD`. Один срез в сутки — уникальность в
  /// базе, а не в порядке вызовов: воркер тикает часто.
  dayKey      String   @unique @map("day_key")
  capturedAt  DateTime @default(now()) @map("captured_at")
  impressions Int      @default(0)
  clicks      Int      @default(0)
  /// Средняя позиция взвешена по показам. `null` — замера не было вовсе, и это
  /// не то же самое, что «позиция ноль».
  averagePosition Float? @map("average_position")
  /// B697: уровень известен только за сутки, когда срез действительно снимался.
  /// Хвост окна переснимается посуточным рядом источника — там есть поток, но
  /// нет состояния индексации на тот день, и `0` вместо него был бы неправдой.
  searchablePages Int?  @map("searchable_pages")
  organicVisits   Int   @default(0) @map("organic_visits")
  observedQueries Int?  @map("observed_queries")
  /// Состояние каждого источника на момент среза: живой замер это или отказ.
  sources     Json?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([dayKey])
  @@map("marketing_daily_snapshots")
}

model MarketingAutomationSignal {
  id              String   @id @default(cuid())
