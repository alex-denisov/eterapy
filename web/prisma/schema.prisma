generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  password            String
  role                Role      @default(CLIENT)
  emailVerified       Boolean   @default(false)
  avatarUrl           String?
  deletedAt           DateTime?          // deactivated at this time, purge after 10 days
  blockedAt           DateTime?          // blocked by admin — cannot login
  freeToolsLimit      Int?               // null = plan default (3), 0 = unlimited
  verificationToken   String?   @unique
  verificationExpires DateTime?
  resetToken          String?   @unique
  resetExpires        DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Identity
  provider            String?   @default("web") // "vk", "google", "web", "mobile_web", "ios", "android", "manual", "telegram", "max"
  providerId          String?   // ID from provider (e.g., VK user_id, Google sub)
  registrationChannel String?   // "site", "google", "vk", "telegram", "referral" — откуда пришёл

  @@index([provider, providerId])
  @@index([email, provider])

  // Telegram
  telegramId          String?   @unique  // Telegram chat_id (set via bot)
  telegramUsername    String?             // @username

  // Extended profile (for AI personalization)
  birthDate           DateTime?
  birthTime           String?             // "14:30" — for natal chart
  birthPlace          String?             // city name
  timezone            String?             // e.g. "Europe/Moscow"
  maritalStatus       String?             // single/married/divorced/etc
  occupation          String?
  aiGoals             String[]  @default([]) // career/relationships/selfdev/health/etc

  // Relations
  practitioner        Practitioner?
  bookingsAsClient    Booking[]     @relation("BookingClient")
  toolSessions        ToolSession[]
  reviewsWritten      Review[]      @relation("ReviewAuthor")
  storedFiles         StoredFile[]
  chatMessages        ChatMessage[]
  notificationPrefs   NotificationPreference[]
  notifications       Notification[]
  complaints          Complaint[]           @relation("ComplaintReporter")
  aiSessionLogs       AISessionLog[]
  aiGatewayRequests   AIRequest[]
  dialogues           Dialogue[]
  productResults      ProductResult[]
  balance             Int                   @default(0)  // in kopecks (100 = 1 ₽)
  transactions        Transaction[]
  savedCards          SavedCard[]
  entitlements        ProductEntitlement[]
  subscriptions       UserSubscription[]
  creditLedgerEntries CreditLedgerEntry[]
  clarityCreditLedgerEntries ClarityCreditLedgerEntry[]
  compatibilitiesCreated Compatibility[] @relation("CompatibilityCreator")
  compatibilitiesJoined  Compatibility[] @relation("CompatibilityPartner")
  clarityCirclesCreated ClarityCircle[] @relation("ClarityCircleCreator")
  clarityCircleParticipations ClarityCircleParticipant[]
  clarityRoutes          ClarityRoute[]
  dailyCards             DailyCard[]
  shareLinks             ShareLink[] @relation("ShareLinkOwner")
  referralsGiven         ReferralAttribution[] @relation("ReferralReferrer")
  referralsReceived      ReferralAttribution[] @relation("ReferralReferredUser")

  @@map("users")
}

enum Role {
  CLIENT
  PRACTITIONER
  ADMIN        // Базовый администратор: одобрение практиков, работа с жалобами
  SUPERADMIN   // Полный доступ: система, выплаты, все данные, метрики
}

// ─── Practitioners ────────────────────────────────────────────────────────────

model Practitioner {
  id              String              @id @default(cuid())
  slug            String              @unique @default("pending")  // "anna-ivanova", "elena-petrova-2"
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  status          PractitionerStatus  @default(PENDING)
  title           String              // "Таролог · Астролог"
  bio             String
  experience      String              // "5 лет"
  pricePerSession   Int                 // RUB
  sessionDuration   Int                 @default(60) // минут: 30, 45, 60, 90
  commissionPercent Int                 @default(25) // % комиссии платформы
  languages         String[]            @default(["Русский"])
  verified        Boolean             @default(false)
  founding        Boolean             @default(false)
  specialties     Specialty[]
  tags            String[]            @default([])

  // Рейтинг (денормализован для скорости)
  ratingSum       Float               @default(0)
  reviewCount     Int                 @default(0)
  sessionCount    Int                 @default(0)

  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  slots           TimeSlot[]
  bookings        Booking[]           @relation("BookingPractitioner")
  reviews         Review[]            @relation("ReviewPractitioner")
  scheduleRules   ScheduleRule[]
  blockedSlots    BlockedSlot[]
  priceRates      PriceRate[]
  payouts         Payout[]
  payoutDetails   PayoutDetails?

  @@map("practitioners")
}

// ─── Practitioner Schedule ────────────────────────────────────────────────────

// Стандартное расписание: когда практик работает по умолчанию
model ScheduleRule {
  id              String       @id @default(cuid())
  practitionerId  String
  practitioner    Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  dayOfWeek       Int          // 0=вс, 1=пн, ... 6=сб
  startHour       Int          // 0-23
  startMinute     Int          @default(0)
  endHour         Int
  endMinute       Int          @default(0)
  enabled         Boolean      @default(true)

  @@unique([practitionerId, dayOfWeek])
  @@index([practitionerId])
  @@map("schedule_rules")
}

// Заблокированные слоты (практик закрыл время)
model BlockedSlot {
  id              String       @id @default(cuid())
  practitionerId  String
  practitioner    Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  startAt         DateTime
  endAt           DateTime

  @@index([practitionerId, startAt])
  @@map("blocked_slots")
}

// ─── Price Rates ──────────────────────────────────────────────────────────────

// Тарифная сетка практика
model PriceRate {
  id              String       @id @default(cuid())
  practitionerId  String
  practitioner    Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  durationMin     Int          // 15, 30, 45, 60, 90, 120
  priceRub        Int
  enabled         Boolean      @default(true)

  @@unique([practitionerId, durationMin])
  @@index([practitionerId])
  @@map("price_rates")
}

enum PractitionerStatus {
  PENDING      // Заявка подана
  ACTIVE       // Активен
  SUSPENDED    // Приостановлен
  BLOCKED      // Заблокирован
}

enum Specialty {
  TAROT
  ASTROLOGY
  NUMEROLOGY
  PSYCHIC
  RUNES
  DREAMS
}

// ─── Time Slots ───────────────────────────────────────────────────────────────

model TimeSlot {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  startAt        DateTime
  endAt          DateTime
  available      Boolean      @default(true)

  booking        Booking?

  @@index([practitionerId, startAt])
  @@map("time_slots")
}

// ─── Bookings ─────────────────────────────────────────────────────────────────

model Booking {
  id             String        @id @default(cuid())
  clientId       String
  client         User          @relation("BookingClient", fields: [clientId], references: [id])
  practitionerId String
  practitioner   Practitioner  @relation("BookingPractitioner", fields: [practitionerId], references: [id])
  slotId         String?       @unique
  slot           TimeSlot?     @relation(fields: [slotId], references: [id])

  status         BookingStatus @default(PENDING)
  priceRub       Int
  paymentId      String?       @unique  // ЮKassa / Stripe payment ID
  paymentMethod  String?       // "yukassa" | "stripe"

  // Видеосессия
  roomId         String?       // LiveKit room ID
  startedAt      DateTime?
  endedAt        DateTime?

  // Напоминания (cron)
  reminder24hSent Boolean      @default(false)
  reminder1hSent  Boolean      @default(false)

  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  review         Review?
  videoSession   VideoSession?
  complaints     Complaint[]
  payment        Payment?
  payouts        Payout[]

  @@index([clientId])
  @@index([practitionerId])
  @@map("bookings")
}

enum BookingStatus {
  PENDING      // Ожидает подтверждения
  CONFIRMED    // Подтверждена
  IN_PROGRESS  // Сессия идёт
  COMPLETED    // Завершена, деньги удержаны
  CANCELLED    // Отменена
  DISPUTED     // Жалоба подана
  REFUNDED     // Возврат
  EXPIRED      // Пропущена (не явился)
}

// ─── Reviews ──────────────────────────────────────────────────────────────────

model Review {
  id             String       @id @default(cuid())
  bookingId      String       @unique
  booking        Booking      @relation(fields: [bookingId], references: [id])
  authorId       String
  author         User         @relation("ReviewAuthor", fields: [authorId], references: [id])
  practitionerId String
  practitioner   Practitioner @relation("ReviewPractitioner", fields: [practitionerId], references: [id])

  rating         Int          // 1-5
  text           String?
  createdAt      DateTime     @default(now())

  @@index([practitionerId])
  @@map("reviews")
}

// ─── Video Sessions & Chat ────────────────────────────────────────────────────

model VideoSession {
  id              String        @id @default(cuid())
  bookingId       String        @unique
  booking         Booking       @relation(fields: [bookingId], references: [id])
  roomName        String        @unique  // LiveKit room name
  status          VideoStatus   @default(WAITING)
  startedAt       DateTime?
  endedAt         DateTime?
  recordingUrl    String?       // path to recording file
  recordingExpiry DateTime?     // 24h TTL
  transcriptText  String?       // full transcript after session
  summaryText     String?       // AI summary for practitioner
  createdAt       DateTime      @default(now())

  messages        ChatMessage[]

  @@index([bookingId])
  @@map("video_sessions")
}

enum VideoStatus {
  WAITING     // room created, not started
  ACTIVE      // session in progress
  ENDED       // session finished
  RECORDING   // post-processing recording
}

model ChatMessage {
  id            String       @id @default(cuid())
  videoSessionId String
  videoSession  VideoSession @relation(fields: [videoSessionId], references: [id], onDelete: Cascade)
  senderId      String
  sender        User         @relation(fields: [senderId], references: [id])
  text          String?
  fileUrl       String?      // uploaded file path
  fileName      String?
  fileMime      String?
  createdAt     DateTime     @default(now())

  @@index([videoSessionId, createdAt])
  @@map("chat_messages")
}

// ─── Audit Log ────────────────────────────────────────────────────────────────

model AuditLog {
  id          String   @id @default(cuid())
  userId      String                    // actor (who did it)
  targetId    String?                   // target user id
  action      String                    // LOGIN, LOGOUT, PROFILE_UPDATE, PASSWORD_RESET, etc.
  details     String?                   // JSON details
  ip          String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([targetId, createdAt])
  @@map("audit_logs")
}

// ─── Durable Jobs ────────────────────────────────────────────────────────────

model Job {
  id             String    @id @default(cuid())
  queue          String    @default("default")
  type           String
  status         JobStatus @default(PENDING)
  priority       Int       @default(0)
  payload        Json
  result         Json?
  error          String?
  attempts       Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  runAfter       DateTime  @default(now()) @map("run_after")
  lockedAt       DateTime? @map("locked_at")
  lockedBy       String?   @map("locked_by")
  startedAt      DateTime? @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  idempotencyKey String?   @map("idempotency_key")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([queue, type, idempotencyKey], map: "jobs_queue_type_idempotency_key_key")
  @@index([status, runAfter, priority, createdAt])
  @@index([queue, status, runAfter])
  @@index([lockedAt])
  @@map("jobs")
}

enum JobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  DEAD
}

// ─── External Webhooks ────────────────────────────────────────────────────────

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  eventType   String
  resourceId  String?
  status      String    @default("PROCESSING")
  payload     Json?
  result      Json?
  error       String?
  requestId   String?
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([provider, receivedAt])
  @@index([provider, resourceId])
  @@map("webhook_events")
}

// ─── Moderator Permissions ────────────────────────────────────────────────────

model ModeratorPermission {
  id           String  @id @default(cuid())
  moderatorId  String
  permission   String  // e.g. "clients.view", "clients.edit", "practitioners.create"
  granted      Boolean @default(true)

  @@unique([moderatorId, permission])
  @@map("moderator_permissions")
}

// ─── User Block ───────────────────────────────────────────────────────────────

// blockedAt stored in User.deletedAt reuse OR separate field
// Using a separate simple approach: add blocked flag to User

// ─── Complaints ──────────────────────────────────────────────────────────────

model Complaint {
  id          String          @id @default(cuid())
  bookingId   String
  booking     Booking         @relation(fields: [bookingId], references: [id])
  reportedBy  String
  reporter    User            @relation("ComplaintReporter", fields: [reportedBy], references: [id])
  reason      ComplaintReason
  description String
  status      String          @default("OPEN") // OPEN | REVIEWING | RESOLVED | CLOSED
  resolution  String?
  resolvedBy  String?
  resolvedAt  DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([bookingId])
  @@index([status, createdAt])
  @@map("complaints")
}

enum ComplaintReason {
  PRACTITIONER_NO_SHOW     // Практик не явился
  ETHICAL_VIOLATION        // Нарушение этического кодекса
  MANIPULATION             // Запугивание/манипуляции
  TECHNICAL_ISSUE          // Технический сбой
  EARLY_TERMINATION        // Сессия закончилась раньше времени
  PAYMENT_ISSUE            // Проблема с оплатой
  OTHER                    // Другое
}

// ─── Notifications ────────────────────────────────────────────────────────────

// Какие уведомления получать и через какой канал
model NotificationPreference {
  id          String              @id @default(cuid())
  userId      String
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       NotificationEvent
  channel     NotificationChannel
  enabled     Boolean             @default(true)
  // Для событий типа "напомни за N часов"
  remindBeforeHours Int?          // null = нет напоминания, 24 = за сутки, 1 = за час

  @@unique([userId, event, channel])
  @@index([userId])
  @@map("notification_preferences")
}

enum NotificationEvent {
  BOOKING_REQUESTED      // Новое бронирование (для практика)
  BOOKING_CONFIRMED      // Бронирование подтверждено (для клиента)
  BOOKING_CANCELLED      // Бронирование отменено
  BOOKING_REMINDER       // Напоминание о предстоящей сессии
  SESSION_STARTED        // Сессия началась
  SESSION_COMPLETED      // Сессия завершена
  REVIEW_REQUESTED       // Просьба оставить отзыв
  NEW_REVIEW             // Новый отзыв (для практика)
  PAYMENT_RECEIVED       // Платёж получен
  PAYOUT_SCHEDULED       // Запланированная выплата практикам (для superadmin)
  BALANCE_TOPUP          // Пополнение баланса (для клиента/практика)
  PRODUCT_UNLOCKED       // Платный продукт открыт
  SUBSCRIPTION_STARTED   // Подписка активирована
  SUBSCRIPTION_CANCELLED // Подписка отменена
  SUBSCRIPTION_PAYMENT_FAILED // Платеж подписки не прошел
  CARD_LINKED            // Новая карта привязана
  CARD_REMOVED           // Карта отвязана
  DAILY_CARD             // Ежедневная карта ясности
}

enum NotificationChannel {
  EMAIL
  TELEGRAM
  WEB          // Уведомление в дропдауне кабинета (колокольчик)
}

// Запись событий для WEB-канала: показываются в дропдауне колокольчика.
model Notification {
  id        String            @id @default(cuid())
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     NotificationEvent
  title     String
  body      String
  href      String?           // deep-link
  readAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, createdAt])
  @@map("notifications")
}

model DailyCard {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  cardDate  DateTime @map("card_date")
  title     String
  body      String
  prompt    String
  metadata  Json?
  sharedAt  DateTime? @map("shared_at")
  completedAt DateTime? @map("completed_at")
  reflectionText String? @map("reflection_text")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, cardDate])
  @@index([userId, createdAt])
  @@map("daily_cards")
}

model ShareLink {
  id             String   @id @default(cuid())
  token          String   @unique
  ownerUserId    String?  @map("owner_user_id")
  owner          User?    @relation("ShareLinkOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  sourceType     String   @map("source_type")
  sourceId       String?  @map("source_id")
  sourceLabel    String?  @map("source_label")
  topic          String?
  previewText    String   @map("preview_text")
  hideQuestion   Boolean  @default(true) @map("hide_question")
  showWatermark  Boolean  @default(true) @map("show_watermark")
  openedCount    Int      @default(0) @map("opened_count")
  lastOpenedAt   DateTime? @map("last_opened_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  referrals      ReferralAttribution[]

  @@index([ownerUserId, createdAt])
  @@index([sourceType, sourceId])
  @@map("share_links")
}

model ReferralAttribution {
  id                 String   @id @default(cuid())
  shareLinkId        String?  @map("share_link_id")
  shareLink          ShareLink? @relation(fields: [shareLinkId], references: [id], onDelete: SetNull)
  referrerUserId     String?  @map("referrer_user_id")
  referrer           User?    @relation("ReferralReferrer", fields: [referrerUserId], references: [id], onDelete: SetNull)
  referredUserId     String?  @map("referred_user_id")
  referredUser       User?    @relation("ReferralReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)
  visitorHash        String   @map("visitor_hash")
  source             String   @default("share")
  status             String   @default("OPENED") // OPENED | REGISTERED | REWARDED | BLOCKED
  blockedReason      String?  @map("blocked_reason")
  meaningfulActionAt DateTime? @map("meaningful_action_at")
  rewardGrantedAt    DateTime? @map("reward_granted_at")
  metadata           Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@unique([shareLinkId, visitorHash])
  @@index([referrerUserId, status])
  @@index([referredUserId])
  @@index([visitorHash])
  @@map("referral_attributions")
}

// ─── Platform Settings ────────────────────────────────────────────────────────

model PlatformSetting {
  key       String   @id  // e.g. "plan.starter.price", "plan.standard.sessions"
  value     String
  updatedAt DateTime @updatedAt
  updatedBy String?  // userId

  @@map("platform_settings")
}

// ─── File Storage ─────────────────────────────────────────────────────────────

model StoredFile {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        FileKind
  path        String   // /uploads/avatars/xxx.jpg  or  /uploads/docs/xxx.pdf
  originalName String
  mimeType    String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([userId, kind])
  @@map("stored_files")
}

enum FileKind {
  AVATAR
  DOCUMENT      // chat attachments
  REPORT        // AI tool reports (human design, natal, etc.)
}

// ─── Practitioner Applications ───────────────────────────────────────────────

model PractitionerApplication {
  id          String   @id @default(cuid())
  name        String
  email       String
  telegram    String?
  specialties String[]
  experience  String
  formats     String[]
  about       String
  why         String?
  portfolio   String?
  status      String   @default("PENDING") // PENDING | REVIEWING | APPROVED | REJECTED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status, createdAt])
  @@map("practitioner_applications")
}

// ─── Telegram Link Tokens ─────────────────────────────────────────────────────

model TelegramLinkToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("telegram_link_tokens")
}

// ─── Payments ─────────────────────────────────────────────────────────────────

model Payment {
  id            String    @id @default(cuid())
  bookingId     String    @unique
  booking       Booking   @relation(fields: [bookingId], references: [id])
  externalId    String?   // ЮKassa payment ID
  amountKopecks Int       // в копейках
  currency      String    @default("RUB")
  status        String    // PENDING / PAID / CANCELLED / REFUNDED
  refundedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@map("payments")
}

// ─── Payouts ──────────────────────────────────────────────────────────────────

model Payout {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id])
  bookingId      String?
  booking        Booking?     @relation(fields: [bookingId], references: [id])
  amountKopecks  Int
  status         String       // PENDING / HELD / PROCESSING / DONE / FAILED
  initiatedBy    String       // adminUserId
  externalId     String?      // ЮKassa payout ID
  createdAt      DateTime     @default(now())
  processedAt    DateTime?

  @@index([practitionerId])
  @@index([bookingId])
  @@map("payouts")
}

model PayoutDetails {
  id             String       @id @default(cuid())
  practitionerId String       @unique
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id])
  type           String       // CARD / SBP
  accountNumber  String       // номер карты или телефон
  bankName       String?
  updatedAt      DateTime     @updatedAt

  @@map("payout_details")
}

// ─── AI Session Log ───────────────────────────────────────────────────────────

// ─── v5 Dialogues ────────────────────────────────────────────────────────────

model Dialogue {
  id             String           @id @default(cuid())
  userId         String?          @map("user_id")
  user           User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId String?          @map("guest_session_id")
  status         DialogueStatus   @default(OPEN)
  title          String
  topic          String?
  difficulty     String?
  safetyLevel    String?          @map("safety_level")
  metadata       Json?
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")
  archivedAt     DateTime?        @map("archived_at")
  deletedAt      DateTime?        @map("deleted_at")

  messages       DialogueMessage[]
  productResults ProductResult[]
  clarityRoutes  ClarityRoute[]

  @@index([userId, updatedAt])
  @@index([guestSessionId, updatedAt])
  @@index([status, updatedAt])
  @@map("dialogues")
}

model DialogueMessage {
  id         String              @id @default(cuid())
  dialogueId String              @map("dialogue_id")
  dialogue   Dialogue            @relation(fields: [dialogueId], references: [id], onDelete: Cascade)
  role       DialogueMessageRole
  content    String
  metadata   Json?
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([dialogueId, createdAt])
  @@map("dialogue_messages")
}

enum DialogueStatus {
  OPEN
  AWAITING_USER
  PROCESSING
  ANSWERED
  SAFETY_INTERRUPTED
  ARCHIVED
  DELETED
}

enum DialogueMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model ProductResult {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dialogueId  String?   @map("dialogue_id")
  dialogue    Dialogue? @relation(fields: [dialogueId], references: [id], onDelete: SetNull)
  productKey  String    @map("product_key")
  status      String    @default("PREVIEW") // PREVIEW | READY | DELETED
  title       String
  previewText String?   @map("preview_text")
  resultText  String?   @map("result_text")
  savedAt     DateTime? @map("saved_at")
  exportedAt  DateTime? @map("exported_at")
  deletedAt   DateTime? @map("deleted_at")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  compatibility Compatibility?
  clarityCircle ClarityCircle?
  clarityRoute  ClarityRoute?

  @@index([userId, productKey, updatedAt])
  @@index([dialogueId, productKey])
  @@index([status, updatedAt])
  @@map("product_results")
}

// Сохранённые результаты AI-инструментов для истории в кабинете
model AISessionLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      ToolType
  title     String   // Краткий заголовок (генерируется AI или по первому вопросу)
  prompt    String?  // Входные данные (вопрос, дата рождения и т.д.)
  result    String   // Текст ответа AI
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("ai_session_logs")
}

// ─── AI Gateway ──────────────────────────────────────────────────────────────

model AIProviderConfig {
  id                    String     @id @default(cuid())
  provider              AIProvider @unique
  displayName           String     @map("display_name")
  enabled               Boolean    @default(false)
  priority              Int        @default(100)
  baseUrl               String?    @map("base_url")
  defaultModel          String?    @map("default_model")
  timeoutMs             Int        @default(30000) @map("timeout_ms")
  rpmLimit              Int?       @map("rpm_limit")
  tpmLimit              Int?       @map("tpm_limit")
  inputTokenCostMicros  Int?       @map("input_token_cost_micros")
  outputTokenCostMicros Int?       @map("output_token_cost_micros")
  metadata              Json?
  createdAt             DateTime   @default(now()) @map("created_at")
  updatedAt             DateTime   @updatedAt @map("updated_at")

  @@index([enabled, priority])
  @@map("ai_provider_configs")
}

model AIRoutingPolicy {
  id                      String       @id @default(cuid())
  feature                 String       @unique
  enabled                 Boolean      @default(true)
  providerOrder           AIProvider[] @default([]) @map("provider_order")
  modelPreferences        Json?        @map("model_preferences")
  maxTokens               Int?         @map("max_tokens")
  temperature             Float?
  timeoutMs               Int?         @map("timeout_ms")
  dailyTokenBudget        Int?         @map("daily_token_budget")
  perUserDailyTokenBudget Int?         @map("per_user_daily_token_budget")
  metadata                Json?
  createdAt               DateTime     @default(now()) @map("created_at")
  updatedAt               DateTime     @updatedAt @map("updated_at")

  @@index([enabled, feature])
  @@map("ai_routing_policies")
}

model AIRequest {
  id                  String          @id @default(cuid())
  feature             String
  userId              String?         @map("user_id")
  user                User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  status              AIRequestStatus @default(PENDING)
  requestHash         String?         @map("request_hash")
  promptTokens        Int             @default(0) @map("prompt_tokens")
  completionTokens    Int             @default(0) @map("completion_tokens")
  totalTokens         Int             @default(0) @map("total_tokens")
  estimatedCostMicros Int             @default(0) @map("estimated_cost_micros")
  metadata            Json?
  startedAt           DateTime?       @map("started_at")
  finishedAt          DateTime?       @map("finished_at")
  createdAt           DateTime        @default(now()) @map("created_at")
  updatedAt           DateTime        @updatedAt @map("updated_at")

  attempts            AIAttempt[]

  @@index([feature, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("ai_requests")
}

model AIAttempt {
  id                  String          @id @default(cuid())
  aiRequestId         String          @map("ai_request_id")
  aiRequest           AIRequest       @relation(fields: [aiRequestId], references: [id], onDelete: Cascade)
  provider            AIProvider
  model               String
  status              AIAttemptStatus @default(RUNNING)
  latencyMs           Int?            @map("latency_ms")
  promptTokens        Int             @default(0) @map("prompt_tokens")
  completionTokens    Int             @default(0) @map("completion_tokens")
  totalTokens         Int             @default(0) @map("total_tokens")
  estimatedCostMicros Int             @default(0) @map("estimated_cost_micros")
  errorCode           String?         @map("error_code")
  errorMessage        String?         @map("error_message")
  startedAt           DateTime        @default(now()) @map("started_at")
  finishedAt          DateTime?       @map("finished_at")

  @@index([aiRequestId, startedAt])
  @@index([provider, status, startedAt])
  @@map("ai_attempts")
}

model AIBudgetLedger {
  id          String   @id @default(cuid())
  scopeType   String   @map("scope_type") // global | feature | user | plan
  scopeKey    String   @map("scope_key")
  period      String   // YYYY-MM-DD
  tokens      Int      @default(0)
  costMicros  Int      @default(0) @map("cost_micros")
  requestCount Int     @default(0) @map("request_count")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([scopeType, scopeKey, period])
  @@index([period, scopeType])
  @@map("ai_budget_ledger")
}

model AIProviderCredential {
  id                   String     @id @default(cuid())
  provider             AIProvider
  label                String
  encryptedKey         String     @map("encrypted_key")
  enabled              Boolean    @default(true)
  priority             Int        @default(100)
  baseUrlOverride      String?    @map("base_url_override")
  modelOverride        String?    @map("model_override")
  lastUsedAt           DateTime?  @map("last_used_at")
  lastSuccessAt        DateTime?  @map("last_success_at")
  lastErrorAt          DateTime?  @map("last_error_at")
  lastErrorCode        String?    @map("last_error_code")
  lastErrorMessage     String?    @map("last_error_message")
  consecutiveFailures  Int        @default(0) @map("consecutive_failures")
  cooldownUntil        DateTime?  @map("cooldown_until")
  regionBlocked        Boolean    @default(false) @map("region_blocked")
  metadata             Json?
  createdAt            DateTime   @default(now()) @map("created_at")
  updatedAt            DateTime   @updatedAt @map("updated_at")

  @@unique([provider, label])
  @@index([provider, enabled, priority])
  @@index([provider, enabled, lastUsedAt])
  @@map("ai_provider_credentials")
}

model AIProviderModel {
  id              String     @id @default(cuid())
  provider        AIProvider
  modelId         String     @map("model_id")
  displayName     String?    @map("display_name")
  isFree          Boolean    @default(false) @map("is_free")
  contextWindow   Int?       @map("context_window")
  metadata        Json?
  fetchedAt       DateTime   @map("fetched_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@unique([provider, modelId])
  @@index([provider, isFree])
  @@map("ai_provider_models")
}

enum AIProvider {
  OPENAI
  ANTHROPIC
  FIREWORKS
  OPENROUTER
}

enum AIRequestStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AIAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
  TIMEOUT
  RATE_LIMITED
  SKIPPED
}

// ─── Tool Sessions ────────────────────────────────────────────────────────────

model ToolSession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tool      ToolType
  month     String   // "2026-04"
  tier      String   @default("quick") // "quick" (бесплатно, 3/мес) или "full" (платно)
  createdAt DateTime @default(now())

  @@index([userId, month])
  @@map("tool_sessions")
}

enum ToolType {
  TAROT
  CHECKIN
  NATAL
  NUMEROLOGY
  HOROSCOPE
  GUIDE
}

// ─── Saved Cards (YooKassa Payment Methods) ───────────────────────────────────

model SavedCard {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentMethodId String   @unique  // YooKassa payment_method.id
  last4           String            // last 4 digits
  brand           String            // "visa", "mastercard", "mir"
  expiryMonth     String            // "01"–"12"
  expiryYear      String            // "2026"
  cardholderName  String?           // optional, from user input
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([userId])
  @@map("saved_cards")
}

// ─── Transactions ─────────────────────────────────────────────────────────────

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int                // positive = top-up, negative = charge
  currency    String   @default("RUB")
  status      TransactionStatus @default(PENDING)
  provider    String   @default("yookassa")  // "yookassa", "internal", "manual"
  providerPaymentId String?    // YooKassa payment ID
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@unique([providerPaymentId])
  @@map("transactions")
}

enum TransactionStatus {
  PENDING
  SUCCEEDED
  CANCELLED
  REFUNDED
}

// ─── v5 Entitlements and Subscriptions ───────────────────────────────────────

model ProductEntitlement {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productKey    String
  source        String   @default("purchase") // purchase | subscription | trial | manual | refund_restore
  status        String   @default("ACTIVE")   // ACTIVE | REVOKED | EXPIRED | REFUNDED
  transactionId String?
  validFrom     DateTime @default(now())
  validUntil    DateTime?
  consumedAt    DateTime?
  revokedAt     DateTime?
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status, productKey])
  @@index([transactionId])
  @@index([validUntil])
  @@map("product_entitlements")
}

model UserSubscription {
  id                     String   @id @default(cuid())
  userId                 String
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  planKey                String
  status                 String   @default("TRIALING") // TRIALING | ACTIVE | PAST_DUE | CANCELLED | EXPIRED
  provider               String   @default("yookassa")
  providerSubscriptionId String?
  trialEndsAt            DateTime?
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean  @default(false)
  cancelledAt            DateTime?
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  @@index([userId, status])
  @@index([planKey, status])
  @@index([providerSubscriptionId])
  @@map("user_subscriptions")
}

model CreditLedgerEntry {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountKopecks       Int
  balanceAfterKopecks Int?
  currency            String   @default("RUB")
  type                String   // TOPUP | PRODUCT_PURCHASE | SUBSCRIPTION_CHARGE | REFUND | ADJUSTMENT
  source              String   @default("yookassa")
  transactionId       String?
  description         String?
  metadata            Json?
  createdAt           DateTime @default(now())

  @@index([userId, createdAt])
  @@index([transactionId])
  @@map("credit_ledger_entries")
}

model ClarityCreditLedgerEntry {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount        Int
  balanceAfter  Int?
  type          String    // grant | spend | expire | clawback | adjustment
  source        String    // referral | mission | purchase | subscription | admin | product
  sourceEventId String?
  status        String    @default("confirmed") // pending | confirmed | revoked | expired
  expiresAt     DateTime?
  metadata      Json?
  createdAt     DateTime  @default(now())

  @@index([userId, status, createdAt])
  @@index([source, sourceEventId])
  @@index([expiresAt])
  @@map("clarity_credit_ledger_entries")
}

// ─── Compatibility ────────────────────────────────────────────────────────────

model Compatibility {
  id             String    @id @default(cuid())
  creatorId      String    @map("creator_id")
  creator        User      @relation("CompatibilityCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  partnerId      String?   @map("partner_id")
  partner        User?     @relation("CompatibilityPartner", fields: [partnerId], references: [id], onDelete: SetNull)
  type           String    // romantic | friendship | business | family
  status         String    @default("CREATED") // CREATED | INVITED | PARTNER_COMPLETED | READY | DELETED
  inviteToken    String    @unique @default(cuid()) @map("invite_token")
  inviteExpiresAt DateTime? @map("invite_expires_at")
  creatorDialogueId String? @map("creator_dialogue_id")
  partnerDialogueId String? @map("partner_dialogue_id")
  creatorConsent Boolean   @default(false) @map("creator_consent")
  partnerConsent Boolean   @default(false) @map("partner_consent")
  teaserText     String?   @map("teaser_text")
  riskScore      Int       @default(0) @map("risk_score")
  riskFlags      String[]  @default([]) @map("risk_flags")
  reportId       String?   @unique @map("report_id")
  report         ProductResult? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([creatorId])
  @@index([partnerId])
  @@index([inviteToken])
  @@index([inviteExpiresAt])
  @@map("compatibilities")
  }

model ClarityCircle {
  id              String    @id @default(cuid())
  creatorId       String    @map("creator_id")
  creator         User      @relation("ClarityCircleCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  question        String
  topic           String?
  status          String    @default("INVITING") // INVITING | READY | DELETED
  inviteToken     String    @unique @default(cuid()) @map("invite_token")
  inviteExpiresAt DateTime  @map("invite_expires_at")
  teaserText      String?   @map("teaser_text")
  reportId        String?   @unique @map("report_id")
  report          ProductResult? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  metadata        Json?
  participants    ClarityCircleParticipant[]
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([creatorId, status, createdAt])
  @@index([inviteToken])
  @@index([inviteExpiresAt])
  @@map("clarity_circles")
}

model ClarityCircleParticipant {
  id          String    @id @default(cuid())
  circleId    String    @map("circle_id")
  circle      ClarityCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId      String?   @map("user_id")
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  displayName String?   @map("display_name")
  answerText  String    @map("answer_text")
  consent     Boolean   @default(false)
  status      String    @default("SUBMITTED") // SUBMITTED | HIDDEN | DELETED
  riskScore   Int       @default(0) @map("risk_score")
  riskFlags   String[]  @default([]) @map("risk_flags")
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@unique([circleId, userId])
  @@index([circleId, status, createdAt])
  @@index([userId])
  @@map("clarity_circle_participants")
}

  // ─── 7 Days to Clarity ────────────────────────────────────────────────────────

  model ClarityRoute {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dialogueId  String?   @map("dialogue_id")
  dialogue    Dialogue? @relation(fields: [dialogueId], references: [id], onDelete: SetNull)
  title       String
  status      String    @default("ACTIVE") // ACTIVE | PAUSED | COMPLETED | CANCELLED
  currentDay  Int       @default(1) @map("current_day")
  reportId    String?   @unique @map("report_id")
  report      ProductResult? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")

  @@index([userId])
  @@index([status])
  @@map("clarity_routes")
}
