  status               String // PENDING / PAID / CANCELLED / REFUNDED
  paymentDeclineReason String?   @map("payment_decline_reason")
  offerVersion         String?   @map("offer_version")
  termsVersion         String?   @map("terms_version")
  consentVersion       String?   @map("consent_version")
  refundedAt           DateTime?
  createdAt            DateTime  @default(now())

  @@map("payments")
}

// ─── Payouts ──────────────────────────────────────────────────────────────────

model Payout {
  id              String       @id @default(cuid())
  practitionerId  String
  practitioner    Practitioner @relation(fields: [practitionerId], references: [id])
  bookingId       String?
  booking         Booking?     @relation(fields: [bookingId], references: [id])
  amountKopecks   Int
  status          String // PENDING / HELD / PROCESSING / DONE / FAILED
  initiatedBy     String // adminUserId
  externalId      String? // ЮKassa payout ID
  availableAt     DateTime?    @map("available_at")
  holdReason      String?      @map("hold_reason")
  holdDays        Int?         @map("hold_days")
  planKeyAtPayout String?      @map("plan_key_at_payout")
  reserveKopecks  Int          @default(0) @map("reserve_kopecks")
  payoutRunId     String?      @map("payout_run_id")
  payoutRun       PayoutRun?   @relation(fields: [payoutRunId], references: [id])
  riskScore       Int          @default(0) @map("risk_score")
  riskFlags       String[]     @default([]) @map("risk_flags")
  createdAt       DateTime     @default(now())
  processedAt     DateTime?

  @@index([practitionerId])
  @@index([bookingId])
  @@index([payoutRunId])
  @@index([status, availableAt])
  @@index([riskScore, createdAt])
