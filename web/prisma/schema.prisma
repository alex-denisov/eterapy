  referredUserId     String?    @map("referred_user_id")
  referredUser       User?      @relation("ReferralReferredUser", fields: [referredUserId], references: [id], onDelete: SetNull)
  visitorHash        String     @map("visitor_hash")
  source             String     @default("share")
