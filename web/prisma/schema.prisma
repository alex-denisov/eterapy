  transactionId String?
  validFrom     DateTime  @default(now())
  validUntil    DateTime?
  consumedAt    DateTime?
  revokedAt     DateTime?
  metadata      Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, status, productKey])
  @@index([transactionId])
  @@index([validUntil])
  @@map("product_entitlements")
