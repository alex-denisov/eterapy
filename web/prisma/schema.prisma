// ─── AI Session Log ───────────────────────────────────────────────────────────

// ─── v5 Dialogues ────────────────────────────────────────────────────────────

model Dialogue {
  id               String         @id @default(cuid())
  userId           String?        @map("user_id")
  user             User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestSessionId   String?        @map("guest_session_id")
  // B372 (M26): лёгкий клиентский отпечаток (sha-256 от UA+canvas+TZ) для
  // гостевого лимита 1 разбор/мес и антифрода. Только для гостевых диалогов.
  guestFingerprint String?        @map("guest_fingerprint")
  dataResidency    String?        @map("data_residency")
  expiresAt        DateTime?      @map("expires_at")
  claimedAt        DateTime?      @map("claimed_at")
  status           DialogueStatus @default(OPEN)
  title            String
  topic            String?
  difficulty       String?
  safetyLevel      String?        @map("safety_level")
  intakeProductKey String?        @map("intake_product_key")
  intakeMode       String?        @map("intake_mode")
  metadata         Json?
  // B363 / Механика 12: explicit, owner-given consent to publish a question in
  // the public library. NULL libraryStatus = private (the strict default — a
  // question is NEVER published without consent). State machine lives in
  // lib/library-consent.ts.
  libraryConsentAt DateTime?      @map("library_consent_at")
  libraryStatus    String?        @map("library_status")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  archivedAt       DateTime?      @map("archived_at")
  deletedAt        DateTime?      @map("deleted_at")

  messages       DialogueMessage[]
  productResults ProductResult[]
  clarityRoutes  ClarityRoute[]

  @@index([userId, updatedAt])
  @@index([userId, intakeProductKey, createdAt])
  @@index([guestSessionId, updatedAt])
  @@index([guestSessionId, intakeProductKey, createdAt])
  @@index([guestSessionId, expiresAt])
  @@index([guestFingerprint, intakeProductKey, createdAt])
  @@index([dataResidency, expiresAt])
  @@index([status, updatedAt])
  @@index([libraryStatus, libraryConsentAt])
  @@map("dialogues")
}

model DialogueMessage {
  id         String              @id @default(cuid())
  dialogueId String              @map("dialogue_id")
  dialogue   Dialogue            @relation(fields: [dialogueId], references: [id], onDelete: Cascade)
  role       DialogueMessageRole
  content    String
  metadata   Json?
  createdAt  DateTime            @default(now()) @map("created_at")

  @@index([dialogueId, createdAt])
  @@map("dialogue_messages")
}

enum DialogueStatus {
  OPEN
  AWAITING_USER
  PROCESSING
  ANSWERED
  SAFETY_INTERRUPTED
  ARCHIVED
  DELETED
}

enum DialogueMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// B386 (M26): «Решить вопрос в чате» — платный чат-компаньон с человеческим ритмом.
// messages — JSON-массив [{role:"user"|"companion", text, at}]. Биллинг сеансами:
// первый мини-чат бесплатно (free_messages_used), затем оплаченное окно
// (paid_started_at..paid_expires_at). premium_included — сеанс из квоты Premium.
model CompanionChatSession {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sourceDialogueId String?   @map("source_dialogue_id")
  // Issue #7: «продолжить разговор в чате» from a chat-analysis разбор keys its
  // own session to that analysis (seeded with its read) instead of falling back
  // to the user's latest unrelated standalone chat (the «чей-то диалог» bug).
  sourceAnalysisId String?   @map("source_analysis_id")
  mode             String    @default("explore")
  status           String    @default("free")
  freeMessagesUsed Int       @default(0) @map("free_messages_used")
  paidStartedAt    DateTime? @map("paid_started_at")
  paidExpiresAt    DateTime? @map("paid_expires_at")
  premiumIncluded  Boolean   @default(false) @map("premium_included")
  messages         Json      @default("[]")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  @@index([userId, updatedAt], map: "companion_chat_user_updated_idx")
  @@index([userId, premiumIncluded, paidStartedAt], map: "companion_chat_premium_quota_idx")
  @@index([userId, sourceAnalysisId], map: "companion_chat_source_analysis_idx")
  @@map("companion_chat_sessions")
}

model ProductResult {
  id          String    @id @default(cuid())
