# Copy to scripts/seo/seo.env (gitignored) and fill in.
# Everything here is local agent tooling — none of it is deployed, and none of
# it belongs in the production .env.

# --- Site under analysis -----------------------------------------------------
SEO_SITE_URL=https://eterapy.com
SEO_SITEMAP_URL=https://eterapy.com/sitemap.xml

# --- IndexNow (Yandex + Bing + Seznam + Naver) -------------------------------
# No account, no application. Generate a 32-hex key, serve it as a plain-text
# file at the key location, then submit URLs. Key file must contain the key and
# nothing else.
#   python3 -c "import secrets;print(secrets.token_hex(16))"
INDEXNOW_KEY=
INDEXNOW_KEY_LOCATION=https://eterapy.com/<key>.txt

# --- Google Search Console (own-site search data only) -----------------------
# Owner grants access once in Search Console; the OAuth client json path and the
# property go here. No analytics data leaves the platform through this tool.
GSC_PROPERTY=sc-domain:eterapy.com
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/service-account.json

# --- PageSpeed Insights / CrUX ----------------------------------------------
# Free key from Google Cloud console, quota-limited, no billing required.
GOOGLE_API_KEY=

# --- Bing Webmaster ----------------------------------------------------------
BING_WEBMASTER_API_KEY=

# --- Drift baselines ---------------------------------------------------------
# Defaults to scripts/seo/.state/drift inside the owning project. Override only
# to share one history across checkouts of the same site.
# SEO_DRIFT_DB=
